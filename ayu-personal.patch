+++ b/submodules/TelegramCore/Sources/AyuPrivacy/AyuActivityPrivacyStorage.swift
@@ -0,0 +1,46 @@
+import Foundation
+import Postbox
+import SwiftSignalKit
+
+// Fork-local preference namespace; separate from upstream core/UI preference ids.
+private let ayuActivityPrivacyKey = applicationSpecificPreferencesKey(900_001)
+
+func ayuActivityPrivacySettings(transaction: Transaction) -> AyuActivityPrivacySettings {
+    return transaction.getPreferencesEntry(key: ayuActivityPrivacyKey)?.get(AyuActivityPrivacySettings.self) ?? .defaultSettings
+}
+
+func observeAyuActivityPrivacySettings(postbox: Postbox) -> Signal<AyuActivityPrivacySettings, NoError> {
+    return postbox.preferencesView(keys: [ayuActivityPrivacyKey])
+    |> map { view -> AyuActivityPrivacySettings in
+        return view.values[ayuActivityPrivacyKey]?.get(AyuActivityPrivacySettings.self) ?? .defaultSettings
+    }
+    |> distinctUntilChanged
+}
+
+func updateAyuActivityPrivacySettings(postbox: Postbox, option: AyuActivityPrivacySettings.Option, value: Bool) -> Signal<Void, NoError> {
+    return postbox.transaction { transaction -> Void in
+        transaction.updatePreferencesEntry(key: ayuActivityPrivacyKey, { current in
+            let settings = current?.get(AyuActivityPrivacySettings.self) ?? .defaultSettings
+            return PreferencesEntry(settings.withUpdated(option, value: value))
+        })
+    }
+}
+
+extension PeerInputActivity {
+    var ayuPrivacyActivity: AyuActivityPrivacySettings.Activity {
+        switch self {
+        case .typingText: return .typing
+        case .recordingVoice: return .recordingVoice
+        case .recordingInstantVideo: return .recordingVideo
+        case .uploadingFile: return .uploadingFile
+        case .uploadingPhoto: return .uploadingPhoto
+        case .uploadingVideo: return .uploadingVideo
+        case .uploadingInstantVideo: return .uploadingVideoMessage
+        case .playingGame: return .playingGame
+        case .choosingSticker: return .choosingSticker
+        case .interactingWithEmoji: return .interactingWithEmoji
+        case .seeingEmojiInteraction: return .seeingEmojiInteraction
+        case .speakingInGroupCall: return .speakingInGroupCall
+        }
+    }
+}
diff --git a/submodules/TelegramCore/Sources/AyuPrivacy/AyuArchiveFileStore.swift b/submodules/TelegramCore/Sources/AyuPrivacy/AyuArchiveFileStore.swift
new file mode 100644
--- /dev/null
+++ b/submodules/TelegramCore/Sources/AyuPrivacy/AyuArchiveFileStore.swift
@@ -0,0 +1,131 @@
+import Foundation
+import CryptoKit
+import Darwin
+
+struct AyuArchiveFileCopy {
+    let byteCount: Int64
+    let sha256: Data
+}
+
+// Independent storage for view-once snapshots. Playback and recovery still
+// require verification on a real device before the feature is considered ready.
+enum AyuArchiveFileStore {
+    enum CopyError: Error {
+        case destinationExists
+        case temporaryExists
+        case sourceChanged
+        case emptyFile
+        case sizeLimitExceeded
+    }
+
+    static func fileURL(mediaBoxBasePath: String, fileId: Int64) -> URL {
+        return URL(fileURLWithPath: mediaBoxBasePath, isDirectory: true)
+            .deletingLastPathComponent()
+            .appendingPathComponent("ayu-archive", isDirectory: true)
+            .appendingPathComponent("\(fileId).bin", isDirectory: false)
+    }
+
+    // The journal can identify an interrupted copy without scanning or
+    // deleting temporary files belonging to another reservation.
+    static func temporaryURL(mediaBoxBasePath: String, fileId: Int64, token: UUID) -> URL {
+        return fileURL(mediaBoxBasePath: mediaBoxBasePath, fileId: fileId)
+            .deletingLastPathComponent()
+            .appendingPathComponent(".tmp-\(fileId)-\(token.uuidString).part", isDirectory: false)
+    }
+
+    // Call only after the matching reservation is marked deleting in Postbox
+    // and its copy worker has stopped. unlink never recursively removes a
+    // directory; missing paths are already clean. A failure keeps the journal
+    // entry in deleting state for later inspection.
+    static func removeAbandonedReservationFiles(mediaBoxBasePath: String, fileId: Int64, token: UUID) -> Bool {
+        let paths = [temporaryURL(mediaBoxBasePath: mediaBoxBasePath, fileId: fileId, token: token),
+                     fileURL(mediaBoxBasePath: mediaBoxBasePath, fileId: fileId)]
+        for path in paths {
+            let result = path.path.withCString { Darwin.unlink($0) }
+            if result != 0 && errno != ENOENT { return false }
+        }
+        return true
+    }
+
+    // Copies bytes out of MediaBox to a temporary file in the destination
+    // directory, checks the full content and then renames it into place.
+    // The caller must allocate a unique id and reconcile orphaned files after a
+    // crash. This method does not make the Postbox transaction atomic.
+    static func copy(mediaBoxBasePath: String, fileId: Int64, token: UUID, sourcePath: String, expectedSize: Int64, maximumBytes: Int64) throws -> AyuArchiveFileCopy {
+        guard expectedSize > 0 else { throw CopyError.emptyFile }
+        guard maximumBytes > 0, expectedSize <= maximumBytes else { throw CopyError.sizeLimitExceeded }
+        let manager = FileManager.default
+        let destination = fileURL(mediaBoxBasePath: mediaBoxBasePath, fileId: fileId)
+        let directory = destination.deletingLastPathComponent()
+        try manager.createDirectory(at: directory, withIntermediateDirectories: true)
+        guard !manager.fileExists(atPath: destination.path) else {
+            throw CopyError.destinationExists
+        }
+        let temporary = temporaryURL(mediaBoxBasePath: mediaBoxBasePath, fileId: fileId, token: token)
+        let original = try FileHandle(forReadingFrom: URL(fileURLWithPath: sourcePath))
+        defer { try? original.close() }
+        // O_EXCL prevents a repeated or concurrent attempt from truncating a
+        // temporary copy left by the same reservation after a crash.
+        let descriptor = temporary.path.withCString { path in
+            Darwin.open(path, O_WRONLY | O_CREAT | O_EXCL, mode_t(S_IRUSR | S_IWUSR))
+        }
+        guard descriptor >= 0 else {
+            let error = errno
+            if error == EEXIST { throw CopyError.temporaryExists }
+            throw NSError(domain: NSPOSIXErrorDomain, code: Int(error))
+        }
+        var ownsTemporary = true
+        defer { if ownsTemporary { try? manager.removeItem(at: temporary) } }
+        let writer = FileHandle(fileDescriptor: descriptor, closeOnDealloc: true)
+        defer { try? writer.close() }
+        var total: Int64 = 0
+        var hasher = SHA256()
+        while true {
+            let data = try original.read(upToCount: 1024 * 1024) ?? Data()
+            if data.isEmpty { break }
+            let (next, overflow) = total.addingReportingOverflow(Int64(data.count))
+            guard !overflow, next <= expectedSize, next <= maximumBytes else {
+                throw CopyError.sizeLimitExceeded
+            }
+            try writer.write(contentsOf: data)
+            hasher.update(data: data)
+            total = next
+        }
+        guard total == expectedSize else { throw CopyError.sourceChanged }
+        try writer.synchronize()
+        try original.seek(toOffset: 0)
+        let copied = try FileHandle(forReadingFrom: temporary)
+        defer { try? copied.close() }
+        while true {
+            let left = try original.read(upToCount: 1024 * 1024) ?? Data()
+            let right = try copied.read(upToCount: 1024 * 1024) ?? Data()
+            guard left == right else { throw CopyError.sourceChanged }
+            if left.isEmpty { break }
+        }
+        try manager.moveItem(at: temporary, to: destination)
+        ownsTemporary = false
+        return AyuArchiveFileCopy(byteCount: total, sha256: Data(hasher.finalize()))
+    }
+
+    static func sha256(path: String) throws -> Data {
+        let file = try FileHandle(forReadingFrom: URL(fileURLWithPath: path))
+        defer { try? file.close() }
+        var hasher = SHA256()
+        while true {
+            let data = try file.read(upToCount: 1024 * 1024) ?? Data()
+            if data.isEmpty { break }
+            hasher.update(data: data)
+        }
+        return Data(hasher.finalize())
+    }
+
+    static func matches(mediaBoxBasePath: String, fileId: Int64, byteCount: Int64, sha256 expected: Data) -> Bool {
+        guard byteCount > 0, expected.count == 32 else { return false }
+        let path = fileURL(mediaBoxBasePath: mediaBoxBasePath, fileId: fileId).path
+        guard let attributes = try? FileManager.default.attributesOfItem(atPath: path),
+              attributes[.type] as? FileAttributeType == .typeRegular,
+              (attributes[.size] as? NSNumber)?.int64Value == byteCount,
+              let digest = try? sha256(path: path) else { return false }
+        return digest == expected
+    }
+}
diff --git a/submodules/TelegramCore/Sources/AyuPrivacy/AyuArchiveJournal.swift b/submodules/TelegramCore/Sources/AyuPrivacy/AyuArchiveJournal.swift
new file mode 100644
--- /dev/null
+++ b/submodules/TelegramCore/Sources/AyuPrivacy/AyuArchiveJournal.swift
@@ -0,0 +1,296 @@
+import Foundation
+
+// Maximum journal usage after accounting for separately cached attachments.
+// Archive copies represented in the journal must not also be counted as cache.
+func ayuArchiveJournalBudget(totalLimit: Int64, disappearingLimit: Int64, cachedTotal: Int64, cachedDisappearing: Int64) -> Int64? {
+    guard totalLimit >= 0, disappearingLimit >= 0, cachedTotal >= 0, cachedDisappearing >= 0,
+          cachedDisappearing <= cachedTotal else { return nil }
+    let totalAvailable = max(Int64(0), totalLimit - min(totalLimit, cachedTotal))
+    let disappearingAvailable = max(Int64(0), disappearingLimit - min(disappearingLimit, cachedDisappearing))
+    return min(totalAvailable, disappearingAvailable)
+}
+
+// A compact, transaction-local description of one indexed use of a durable
+// archive file. Several messages may refer to the same resource; the file can
+// be removed only when every indexed use is in the requested selection.
+struct AyuArchiveIndexedFile<Key: Hashable> {
+    let key: Key
+    let original: AyuArchiveJournal.MessageIdentity
+    let fileId: Int64
+    let byteCount: Int64
+    let sha256: Data
+}
+
+func ayuArchiveFileIdsForExplicitDeletion<Key: Hashable>(
+    journal: AyuArchiveJournal,
+    indexed: [AyuArchiveIndexedFile<Key>],
+    selected: Set<Key>
+) -> Set<Int64>? {
+    guard journal.isValid else { return nil }
+    let targets = indexed.filter { selected.contains($0.key) }
+    let ids = Set(targets.map(\.fileId))
+    for ref in indexed where ids.contains(ref.fileId) {
+        if let entry = journal.entries.first(where: { $0.fileId == ref.fileId }) {
+            guard entry.message == ref.original, entry.bytes == ref.byteCount,
+                  entry.sha256 == ref.sha256,
+                  entry.state == .committed || entry.state == .burned else { return nil }
+        } else {
+            // Clearing attachments can leave the message itself in history.
+            // A retired id is known to have been removed and can never be
+            // reused, so later deletion of that message needs no second unlink.
+            guard journal.retiredIds.contains(ref.fileId) else { return nil }
+        }
+    }
+    let shared = Set(indexed.filter { !selected.contains($0.key) }.map(\.fileId))
+    let owned = Set(journal.entries.map(\.fileId))
+    return ids.intersection(owned).subtracting(shared)
+}
+
+// Ordinary cached attachments share their limits with independently stored
+// view-once copies. Reservations and pending deletions continue to count.
+func ayuArchiveCacheBudgets(totalLimit: Int64, disappearingLimit: Int64, journalBytes: Int64) -> (total: Int64, disappearing: Int64)? {
+    guard totalLimit >= 0, disappearingLimit >= 0, journalBytes >= 0 else { return nil }
+    return (totalLimit - min(totalLimit, journalBytes),
+            disappearingLimit - min(disappearingLimit, journalBytes))
+}
+
+// A transaction persists each transition before the corresponding file or
+// network operation. Recovery and deletion remain separate responsibilities.
+struct AyuArchiveJournal: Codable, Equatable {
+    struct MessageIdentity: Codable, Hashable {
+        let peerId: Int64
+        let namespace: Int32
+        let id: Int32
+    }
+
+    // A deletion capability is scoped to one journal-owned file and the
+    // reservation token that created it; the filesystem never receives a path
+    // supplied by the user or by a message.
+    struct Deletion: Equatable {
+        let fileId: Int64
+        let token: UUID
+    }
+
+    enum State: String, Codable {
+        case reserved
+        case committed
+        // Persisted before a request: after interruption the server outcome
+        // may be unknown, so this must never trigger an automatic retry.
+        case burnInFlight
+        case burned
+        case deleting
+    }
+
+    struct Entry: Codable, Equatable {
+        let fileId: Int64
+        let token: UUID
+        let message: MessageIdentity
+        let bytes: Int64
+        let createdAt: Int64
+        var state: State
+        var sha256: Data?
+        var sourceResourceId: String?
+
+        // Postbox's Codable adapter does not support the single-value
+        // containers used by UUID and raw-value enum synthesis. Store their
+        // stable textual forms as ordinary keyed strings instead.
+        private enum CodingKeys: String, CodingKey {
+            case fileId, token, message, bytes, createdAt, state, sha256, sourceResourceId
+        }
+
+        init(fileId: Int64, token: UUID, message: MessageIdentity, bytes: Int64, createdAt: Int64, state: State, sha256: Data?, sourceResourceId: String? = nil) {
+            self.fileId = fileId
+            self.token = token
+            self.message = message
+            self.bytes = bytes
+            self.createdAt = createdAt
+            self.state = state
+            self.sha256 = sha256
+            self.sourceResourceId = sourceResourceId
+        }
+
+        init(from decoder: Decoder) throws {
+            let container = try decoder.container(keyedBy: CodingKeys.self)
+            self.fileId = try container.decode(Int64.self, forKey: .fileId)
+            let rawToken = try container.decode(String.self, forKey: .token)
+            guard let token = UUID(uuidString: rawToken) else {
+                throw DecodingError.dataCorruptedError(forKey: .token, in: container, debugDescription: "Invalid archive token")
+            }
+            self.token = token
+            self.message = try container.decode(MessageIdentity.self, forKey: .message)
+            self.bytes = try container.decode(Int64.self, forKey: .bytes)
+            self.createdAt = try container.decode(Int64.self, forKey: .createdAt)
+            let rawState = try container.decode(String.self, forKey: .state)
+            guard let state = State(rawValue: rawState) else {
+                throw DecodingError.dataCorruptedError(forKey: .state, in: container, debugDescription: "Invalid archive state")
+            }
+            self.state = state
+            self.sha256 = try container.decodeIfPresent(Data.self, forKey: .sha256)
+            self.sourceResourceId = try container.decodeIfPresent(String.self, forKey: .sourceResourceId)
+        }
+
+        func encode(to encoder: Encoder) throws {
+            var container = encoder.container(keyedBy: CodingKeys.self)
+            try container.encode(fileId, forKey: .fileId)
+            try container.encode(token.uuidString, forKey: .token)
+            try container.encode(message, forKey: .message)
+            try container.encode(bytes, forKey: .bytes)
+            try container.encode(createdAt, forKey: .createdAt)
+            try container.encode(state.rawValue, forKey: .state)
+            try container.encodeIfPresent(sha256, forKey: .sha256)
+            try container.encodeIfPresent(sourceResourceId, forKey: .sourceResourceId)
+        }
+    }
+
+    enum RecoveryAction: Equatable {
+        // These are inspection requests, not permission to unlink a file.
+        case inspectAbandonedReservation(fileId: Int64, token: UUID)
+        case inspectPendingDeletion(fileId: Int64, token: UUID)
+        case inspectUnconfirmedBurn(fileId: Int64, token: UUID)
+    }
+
+    private(set) var entries: [Entry] = []
+    // Never reuse an identifier in this account: a delayed unlink must not
+    // target a new file after a previous deletion has completed.
+    private(set) var retiredIds: Set<Int64> = []
+
+    var accountedBytes: Int64? {
+        var result: Int64 = 0
+        for entry in entries {
+            guard entry.bytes > 0 else { return nil }
+            let (next, overflow) = result.addingReportingOverflow(entry.bytes)
+            guard !overflow else { return nil }
+            result = next
+        }
+        return result
+    }
+
+    var isValid: Bool {
+        var ids = Set<Int64>()
+        var tokens = Set<UUID>()
+        var messages = Set<MessageIdentity>()
+        for entry in entries {
+            guard entry.bytes > 0, ids.insert(entry.fileId).inserted,
+                  tokens.insert(entry.token).inserted, entry.message.id > 0,
+                  messages.insert(entry.message).inserted, !retiredIds.contains(entry.fileId) else { return false }
+            if let sourceResourceId = entry.sourceResourceId, sourceResourceId.isEmpty || sourceResourceId.utf8.count > 1024 { return false }
+            switch entry.state {
+            case .reserved:
+                guard entry.sha256 == nil, entry.sourceResourceId == nil else { return false }
+            case .committed, .burnInFlight, .burned:
+                guard entry.sha256?.count == 32 else { return false }
+            case .deleting:
+                guard entry.sha256 == nil || entry.sha256?.count == 32 else { return false }
+            }
+        }
+        return accountedBytes != nil
+    }
+
+    mutating func reserve(fileId: Int64, token: UUID, message: MessageIdentity, bytes: Int64, createdAt: Int64, limitBytes: Int64) -> Bool {
+        guard isValid, bytes > 0, message.id > 0, limitBytes >= 0, !retiredIds.contains(fileId),
+              !entries.contains(where: { $0.fileId == fileId || $0.token == token || $0.message == message }),
+              let current = accountedBytes else { return false }
+        let (total, overflow) = current.addingReportingOverflow(bytes)
+        guard !overflow, total <= limitBytes else { return false }
+        entries.append(Entry(fileId: fileId, token: token, message: message, bytes: bytes, createdAt: createdAt, state: .reserved, sha256: nil))
+        return true
+    }
+
+    mutating func commit(fileId: Int64, token: UUID, actualBytes: Int64, sha256: Data, sourceResourceId: String? = nil) -> Bool {
+        guard isValid, sha256.count == 32,
+              sourceResourceId.map({ !$0.isEmpty && $0.utf8.count <= 1024 }) ?? true,
+              let index = entries.firstIndex(where: { $0.fileId == fileId && $0.token == token }),
+              entries[index].state == .reserved, entries[index].bytes == actualBytes else { return false }
+        entries[index].sha256 = sha256
+        entries[index].sourceResourceId = sourceResourceId
+        entries[index].state = .committed
+        return true
+    }
+
+    // This transition must commit before the server request is started.
+    // An interrupted request remains ambiguous until explicitly reconciled.
+    mutating func beginBurn(fileId: Int64, token: UUID) -> Bool {
+        guard isValid, let index = entries.firstIndex(where: { $0.fileId == fileId && $0.token == token }),
+              entries[index].state == .committed, entries[index].sourceResourceId != nil else { return false }
+        entries[index].state = .burnInFlight
+        return true
+    }
+
+    // The caller must confirm the remote outcome and update the archived
+    // message in the same Postbox transaction as this journal transition.
+    mutating func confirmBurn(fileId: Int64, token: UUID) -> Bool {
+        guard isValid, let index = entries.firstIndex(where: { $0.fileId == fileId && $0.token == token }),
+              entries[index].state == .burnInFlight else { return false }
+        entries[index].state = .burned
+        return true
+    }
+
+    // The entry continues consuming quota until durable deletion is confirmed.
+    mutating func markDeleting(fileId: Int64, token: UUID) -> Bool {
+        guard isValid, let index = entries.firstIndex(where: { $0.fileId == fileId && $0.token == token }),
+              entries[index].state != .deleting, entries[index].state != .burnInFlight else { return false }
+        entries[index].state = .deleting
+        return true
+    }
+
+    mutating func confirmDeleted(fileId: Int64, token: UUID) -> Bool {
+        guard isValid, let index = entries.firstIndex(where: { $0.fileId == fileId && $0.token == token }),
+              entries[index].state == .deleting else { return false }
+        entries.remove(at: index)
+        retiredIds.insert(fileId)
+        return true
+    }
+
+    // Used for an explicit archive deletion, after the caller has checked all
+    // indexed references to the files in the same Postbox transaction. An
+    // active copy or an ambiguous Burn must finish before an archive is
+    // cleared. The mutation is all-or-nothing even for a bad selection.
+    mutating func markExplicitDeletions(fileIds: Set<Int64>) -> [Deletion]? {
+        guard isValid, !entries.contains(where: { $0.state == .reserved || $0.state == .burnInFlight }) else { return nil }
+        let selected = entries.filter { fileIds.contains($0.fileId) }
+        guard selected.count == fileIds.count,
+              selected.allSatisfy({ $0.state == .committed || $0.state == .burned }) else { return nil }
+        var next = self
+        for entry in selected {
+            guard next.markDeleting(fileId: entry.fileId, token: entry.token) else { return nil }
+        }
+        self = next
+        return selected.map { Deletion(fileId: $0.fileId, token: $0.token) }
+    }
+
+    // Only an uncommitted reservation can be abandoned by the copy worker.
+    // Persist this transition before unlinking either of its files.
+    mutating func abandonReservation(fileId: Int64, token: UUID) -> Bool {
+        guard isValid, let entry = entries.first(where: { $0.fileId == fileId && $0.token == token }),
+              entry.state == .reserved else { return false }
+        return markDeleting(fileId: fileId, token: token)
+    }
+
+    // A nil digest distinguishes an abandoned reservation from deletion of a
+    // committed snapshot. The caller must first confirm both unlinks succeeded.
+    mutating func confirmAbandonedReservationDeleted(fileId: Int64, token: UUID) -> Bool {
+        guard isValid, let entry = entries.first(where: { $0.fileId == fileId && $0.token == token }),
+              entry.state == .deleting, entry.sha256 == nil else { return false }
+        return confirmDeleted(fileId: fileId, token: token)
+    }
+
+    // Recovery must verify Postbox ownership and file identity before acting.
+    // Active tokens belong to operations in this process and are never offered
+    // for cleanup. An invalid journal produces no automatic cleanup candidates.
+    func recoveryActions(activeTokens: Set<UUID>, reservationsOlderThan cutoff: Int64) -> [RecoveryAction] {
+        guard isValid else { return [] }
+        return entries.compactMap { entry in
+            guard !activeTokens.contains(entry.token) else { return nil }
+            switch entry.state {
+            case .reserved where entry.createdAt <= cutoff:
+                return .inspectAbandonedReservation(fileId: entry.fileId, token: entry.token)
+            case .deleting:
+                return .inspectPendingDeletion(fileId: entry.fileId, token: entry.token)
+            case .burnInFlight:
+                return .inspectUnconfirmedBurn(fileId: entry.fileId, token: entry.token)
+            default:
+                return nil
+            }
+        }
+    }
+}
diff --git a/submodules/TelegramCore/Sources/AyuPrivacy/AyuArchiveJournalStorage.swift b/submodules/TelegramCore/Sources/AyuPrivacy/AyuArchiveJournalStorage.swift
new file mode 100644
--- /dev/null
+++ b/submodules/TelegramCore/Sources/AyuPrivacy/AyuArchiveJournalStorage.swift
@@ -0,0 +1,68 @@
+import Foundation
+import Postbox
+
+// Only call inside the owning account's Postbox transaction. An absent entry
+// represents a new journal; an unreadable or invalid entry must fail closed.
+func ayuArchiveJournal(transaction: Transaction) -> AyuArchiveJournal? {
+    guard let stored = transaction.getPreferencesEntry(key: PreferencesKeys.ayuArchiveJournal) else {
+        return AyuArchiveJournal()
+    }
+    guard let journal = stored.get(AyuArchiveJournal.self), journal.isValid else {
+        return nil
+    }
+    return journal
+}
+
+// While the server outcome is unknown, keep every archive record intact.
+// An unreadable journal also fails closed. A later coordinator must expose
+// this temporary restriction to the user and reconcile uncertain requests.
+func ayuCanDiscardArchiveCopies(transaction: Transaction) -> Bool {
+    guard let journal = ayuArchiveJournal(transaction: transaction) else { return false }
+    return !journal.entries.contains(where: { $0.state == .burnInFlight })
+}
+
+// Generic bulk-deletion paths have no post-commit file-cleanup coordinator.
+// They must not remove indexed archive records while a durable file exists;
+// the explicit archive controls use the coordinated path instead.
+func ayuCanDiscardArchiveWithoutFileCleanup(transaction: Transaction) -> Bool {
+    guard let journal = ayuArchiveJournal(transaction: transaction) else { return false }
+    return journal.entries.isEmpty
+}
+
+// Active tokens are sampled under the in-process lock in the transaction that
+// marks abandoned reservations. A token is registered before reserve is
+// enqueued, so a new writer cannot appear behind this decision.
+func ayuMarkInactiveArchiveReservations(transaction: Transaction, activeTokens: Set<UUID>) -> [AyuArchiveJournal.Deletion]? {
+    guard var journal = ayuArchiveJournal(transaction: transaction) else { return nil }
+    let inactive = journal.entries.filter { $0.state == .reserved && !activeTokens.contains($0.token) }
+    for entry in inactive {
+        guard journal.abandonReservation(fileId: entry.fileId, token: entry.token) else { return nil }
+    }
+    guard let encoded = PreferencesEntry(journal), encoded.get(AyuArchiveJournal.self) == journal else { return nil }
+    transaction.setPreferencesEntry(key: PreferencesKeys.ayuArchiveJournal, value: encoded)
+    return inactive.map { AyuArchiveJournal.Deletion(fileId: $0.fileId, token: $0.token) }
+}
+
+// Postbox serializes transactions. The caller performs file I/O only after a
+// successful transaction commits, never from within this closure.
+@discardableResult
+func updateAyuArchiveJournal(transaction: Transaction, _ change: (inout AyuArchiveJournal) -> Bool) -> Bool {
+    var changed = false
+    transaction.updatePreferencesEntry(key: PreferencesKeys.ayuArchiveJournal, { previous in
+        var journal: AyuArchiveJournal
+        if let previous {
+            guard let decoded = previous.get(AyuArchiveJournal.self), decoded.isValid else { return previous }
+            journal = decoded
+        } else {
+            journal = AyuArchiveJournal()
+        }
+        guard change(&journal), journal.isValid,
+              let encoded = PreferencesEntry(journal),
+              let roundTrip = encoded.get(AyuArchiveJournal.self), roundTrip == journal else {
+            return previous
+        }
+        changed = true
+        return encoded
+    })
+    return changed
+}
diff --git a/submodules/TelegramCore/Sources/AyuPrivacy/AyuArchiveMediaResource.swift b/submodules/TelegramCore/Sources/AyuPrivacy/AyuArchiveMediaResource.swift
new file mode 100644
--- /dev/null
+++ b/submodules/TelegramCore/Sources/AyuPrivacy/AyuArchiveMediaResource.swift
@@ -0,0 +1,42 @@
+import Foundation
+import Postbox
+
+// A separate resource type prevents an archive copy from shadowing an ordinary
+// LocalFileMediaResource with the same numeric identifier.
+public final class AyuArchiveMediaResource: TelegramMediaResource {
+    public let fileId: Int64
+    public let sha256: Data
+    private let storedSize: Int64
+
+    public init(fileId: Int64, size: Int64, sha256: Data) {
+        self.fileId = fileId
+        self.storedSize = size
+        self.sha256 = sha256
+    }
+
+    public required init(decoder: PostboxDecoder) {
+        self.fileId = decoder.decodeInt64ForKey("f", orElse: 0)
+        self.storedSize = decoder.decodeInt64ForKey("s", orElse: 0)
+        self.sha256 = decoder.decodeDataForKey("h") ?? Data()
+    }
+
+    public func encode(_ encoder: PostboxEncoder) {
+        encoder.encodeInt64(self.fileId, forKey: "f")
+        encoder.encodeInt64(self.storedSize, forKey: "s")
+        encoder.encodeData(self.sha256, forKey: "h")
+    }
+
+    public var id: MediaResourceId {
+        let digest = self.sha256.map { String(format: "%02x", $0) }.joined()
+        return MediaResourceId("ayu-archive-file-\(self.fileId)-\(digest)")
+    }
+
+    public var size: Int64? {
+        return self.storedSize > 0 ? self.storedSize : nil
+    }
+
+    public func isEqual(to: MediaResource) -> Bool {
+        guard let other = to as? AyuArchiveMediaResource else { return false }
+        return self.fileId == other.fileId && self.storedSize == other.storedSize && self.sha256 == other.sha256
+    }
+}
diff --git a/submodules/TelegramCore/Sources/AyuPrivacy/AyuArchiveSnapshotPreparation.swift b/submodules/TelegramCore/Sources/AyuPrivacy/AyuArchiveSnapshotPreparation.swift
new file mode 100644
--- /dev/null
+++ b/submodules/TelegramCore/Sources/AyuPrivacy/AyuArchiveSnapshotPreparation.swift
@@ -0,0 +1,269 @@
+import Foundation
+import Postbox
+import SwiftSignalKit
+
+// Registered before a reservation can be written. An interrupted signal may
+// conservatively retain its token until process exit, but recovery must never
+// unlink a file while this process could still be writing it.
+private let ayuActiveArchiveReservations = Atomic<Set<UUID>>(value: Set())
+
+private func ayuRegisterArchiveReservation(_ token: UUID) {
+    let _ = ayuActiveArchiveReservations.modify { current in
+        var current = current
+        current.insert(token)
+        return current
+    }
+}
+
+private func ayuReleaseArchiveReservation(_ token: UUID) {
+    let _ = ayuActiveArchiveReservations.modify { current in
+        var current = current
+        current.remove(token)
+        return current
+    }
+}
+
+// Prepared outside a Postbox transaction. This value is NOT a committed
+// snapshot: the caller must revalidate the message, source, settings, quotas
+// and storage ownership in a transaction before associating the copied media.
+struct AyuArchiveSnapshotCandidate {
+    let sourceResourceId: MediaResourceId
+    let sourceMedia: Media
+    let archiveFileId: Int64
+    let reservationToken: UUID
+    let byteCount: Int64
+    let sha256: Data
+    let archivedMedia: Media
+}
+
+// Hash verification can be slow for videos and must run outside Postbox's
+// serial transaction queue. The caller must still revalidate the message and
+// reservation inside a transaction; this check cannot make file I/O atomic.
+struct AyuVerifiedArchiveSnapshot {
+    let candidate: AyuArchiveSnapshotCandidate
+
+    private init(candidate: AyuArchiveSnapshotCandidate) {
+        self.candidate = candidate
+    }
+
+    static func verify(_ candidate: AyuArchiveSnapshotCandidate, mediaBoxBasePath: String) -> AyuVerifiedArchiveSnapshot? {
+        guard AyuArchiveFileStore.matches(mediaBoxBasePath: mediaBoxBasePath, fileId: candidate.archiveFileId,
+                                          byteCount: candidate.byteCount, sha256: candidate.sha256) else { return nil }
+        return AyuVerifiedArchiveSnapshot(candidate: candidate)
+    }
+}
+
+// Identifies one committed snapshot without retaining the original cache file.
+// Verify its bytes off the Postbox queue, then recheck this reference in the
+// transaction that marks a Burn as in flight.
+struct AyuBurnSnapshotReference: Equatable {
+    let originalId: MessageId
+    let archivedId: MessageId
+    let fileId: Int64
+    let token: UUID
+    let byteCount: Int64
+    let sha256: Data
+    let sourceResourceId: String
+}
+
+struct AyuVerifiedBurnSnapshot {
+    let reference: AyuBurnSnapshotReference
+
+    private init(reference: AyuBurnSnapshotReference) {
+        self.reference = reference
+    }
+
+    static func verify(_ reference: AyuBurnSnapshotReference, mediaBoxBasePath: String) -> AyuVerifiedBurnSnapshot? {
+        guard AyuArchiveFileStore.matches(mediaBoxBasePath: mediaBoxBasePath, fileId: reference.fileId,
+                                          byteCount: reference.byteCount, sha256: reference.sha256) else { return nil }
+        return AyuVerifiedBurnSnapshot(reference: reference)
+    }
+}
+
+enum AyuArchiveSnapshotPreparationError: Error {
+    case unsupportedMedia
+    case incompleteSource
+    case invalidSize
+    case modelCreationFailed
+}
+
+func ayuViewOnceSourceResourceId(_ media: Media) -> MediaResourceId? {
+    if let image = media as? TelegramMediaImage, let largest = largestImageRepresentation(image.representations) {
+        return largest.resource.id
+    } else if let file = media as? TelegramMediaFile {
+        return file.resource.id
+    }
+    return nil
+}
+
+func ayuPrepareArchiveSnapshot(media: Media, mediaBox: MediaBox, archiveFileId: Int64, reservationToken: UUID, maximumBytes: Int64) throws -> AyuArchiveSnapshotCandidate {
+    let source: TelegramMediaResource
+    if let image = media as? TelegramMediaImage, let largest = largestImageRepresentation(image.representations) {
+        source = largest.resource
+    } else if let file = media as? TelegramMediaFile {
+        source = file.resource
+    } else {
+        throw AyuArchiveSnapshotPreparationError.unsupportedMedia
+    }
+    guard let sourcePath = mediaBox.completedResourcePath(id: source.id) else {
+        throw AyuArchiveSnapshotPreparationError.incompleteSource
+    }
+    let attributes = try FileManager.default.attributesOfItem(atPath: sourcePath)
+    guard attributes[.type] as? FileAttributeType == .typeRegular,
+          let byteCount = (attributes[.size] as? NSNumber)?.int64Value, byteCount > 0 else {
+        throw AyuArchiveSnapshotPreparationError.invalidSize
+    }
+    let copied = try AyuArchiveFileStore.copy(
+        mediaBoxBasePath: mediaBox.basePath,
+        fileId: archiveFileId,
+        token: reservationToken,
+        sourcePath: sourcePath,
+        expectedSize: byteCount,
+        maximumBytes: maximumBytes
+    )
+    guard let archived = ayuArchivedMediaCopy(media, fileId: archiveFileId, size: copied.byteCount, sha256: copied.sha256) else {
+        let destination = AyuArchiveFileStore.fileURL(mediaBoxBasePath: mediaBox.basePath, fileId: archiveFileId)
+        try? FileManager.default.removeItem(at: destination)
+        throw AyuArchiveSnapshotPreparationError.modelCreationFailed
+    }
+    return AyuArchiveSnapshotCandidate(sourceResourceId: source.id, sourceMedia: media, archiveFileId: archiveFileId, reservationToken: reservationToken, byteCount: copied.byteCount, sha256: copied.sha256, archivedMedia: archived)
+}
+
+// Used only after this process's copy worker has returned. The journal owns
+// the id and token, so no other reservation may reuse the destination. If the
+// process stops mid-cleanup, a later recovery pass must inspect the entry.
+private func ayuAbandonViewOnceReservation(postbox: Postbox, fileId: Int64, token: UUID) -> Signal<Bool, NoError> {
+    let mediaBox = postbox.mediaBox
+    return postbox.transaction { transaction -> Bool in
+        return updateAyuArchiveJournal(transaction: transaction) { journal in
+            return journal.abandonReservation(fileId: fileId, token: token)
+        }
+    }
+    |> deliverOn(Queue.concurrentDefaultQueue())
+    |> mapToSignal { marked -> Signal<Bool, NoError> in
+        guard marked, AyuArchiveFileStore.removeAbandonedReservationFiles(mediaBoxBasePath: mediaBox.basePath, fileId: fileId, token: token) else {
+            return .single(false)
+        }
+        return postbox.transaction { transaction -> Bool in
+            return updateAyuArchiveJournal(transaction: transaction) { journal in
+                return journal.confirmAbandonedReservationDeleted(fileId: fileId, token: token)
+            }
+        }
+    }
+}
+
+// An explicit archive deletion marks its exact file ids and tokens in the
+// same transaction as the index change. Unlink only those still marked, off
+// the Postbox queue; keep their quota reserved if either unlink fails. Since
+// retired ids cannot be reused, concurrent cleanup or a restart is harmless.
+func ayuFinishArchiveFileDeletions(postbox: Postbox, requested: [AyuArchiveJournal.Deletion]) -> Signal<Bool, NoError> {
+    return postbox.transaction { transaction -> [AyuArchiveJournal.Deletion] in
+        guard let journal = ayuArchiveJournal(transaction: transaction) else { return [] }
+        return requested.filter { deletion in
+            journal.entries.contains { $0.fileId == deletion.fileId && $0.token == deletion.token && $0.state == .deleting }
+        }
+    }
+    |> deliverOn(Queue.concurrentDefaultQueue())
+    |> mapToSignal { deletions -> Signal<Bool, NoError> in
+        let removed = deletions.filter { deletion in
+            AyuArchiveFileStore.removeAbandonedReservationFiles(mediaBoxBasePath: postbox.mediaBox.basePath, fileId: deletion.fileId, token: deletion.token)
+        }
+        guard !removed.isEmpty else { return .single(deletions.isEmpty) }
+        return postbox.transaction { transaction -> Bool in
+            return updateAyuArchiveJournal(transaction: transaction) { journal in
+                for deletion in removed {
+                    if journal.entries.contains(where: { $0.fileId == deletion.fileId && $0.token == deletion.token && $0.state == .deleting }) {
+                        guard journal.confirmDeleted(fileId: deletion.fileId, token: deletion.token) else { return false }
+                    }
+                }
+                return true
+            }
+        }
+        |> map { updated in updated && removed.count == deletions.count }
+    }
+}
+
+// At startup, an unregistered reservation belongs to an interrupted worker.
+// The transaction marks it first; unknown Burn outcomes are never touched.
+// In-flight workers in this process register before their reservation exists.
+func ayuResumeArchiveFileDeletions(postbox: Postbox) -> Signal<Never, NoError> {
+    return postbox.transaction { transaction -> [AyuArchiveJournal.Deletion] in
+        let active = ayuActiveArchiveReservations.with { $0 }
+        guard ayuMarkInactiveArchiveReservations(transaction: transaction, activeTokens: active) != nil,
+              let journal = ayuArchiveJournal(transaction: transaction) else { return [] }
+        return journal.entries.filter { $0.state == .deleting }.map { AyuArchiveJournal.Deletion(fileId: $0.fileId, token: $0.token) }
+    }
+    |> mapToSignal { deletions -> Signal<Never, NoError> in
+        return ayuFinishArchiveFileDeletions(postbox: postbox, requested: deletions)
+        |> ignoreValues
+    }
+}
+
+// Offline preparation only. It does not send a server request.
+// The returned reference must be verified again and revalidated in Postbox
+// immediately before a Burn.
+func ayuPrepareViewOnceSnapshot(account: Account, messageId: MessageId) -> Signal<AyuBurnSnapshotReference?, NoError> {
+    let postbox = account.postbox
+    let mediaBox = postbox.mediaBox
+    return postbox.transaction { transaction -> (AyuBurnSnapshotReference?, Media?) in
+        guard messageId.peerId.namespace == Namespaces.Peer.CloudUser,
+              messageId.namespace == Namespaces.Message.Cloud,
+              let message = transaction.getMessage(messageId), message.media.count == 1 else { return (nil, nil) }
+        return (ayuPendingBurnReference(transaction: transaction, originalId: messageId, state: .committed), message.media.first)
+    }
+    |> deliverOn(Queue.concurrentDefaultQueue())
+    |> mapToSignal { result -> Signal<AyuBurnSnapshotReference?, NoError> in
+        guard let media = result.1 else { return .single(nil) }
+        if let existing = result.0 {
+            guard ayuViewOnceSourceResourceId(media)?.stringRepresentation == existing.sourceResourceId,
+                  AyuVerifiedBurnSnapshot.verify(existing, mediaBoxBasePath: mediaBox.basePath) != nil else { return .single(nil) }
+            return .single(existing)
+        }
+        let resource: TelegramMediaResource
+        if let image = media as? TelegramMediaImage, let largest = largestImageRepresentation(image.representations) {
+            resource = largest.resource
+        } else if let file = media as? TelegramMediaFile {
+            resource = file.resource
+        } else {
+            return .single(nil)
+        }
+        guard let path = mediaBox.completedResourcePath(id: resource.id),
+              let attributes = try? FileManager.default.attributesOfItem(atPath: path),
+              attributes[.type] as? FileAttributeType == .typeRegular,
+              let bytes = (attributes[.size] as? NSNumber)?.int64Value, bytes > 0 else { return .single(nil) }
+        let fileId = Int64.random(in: Int64.min ... Int64.max)
+        let token = UUID()
+        let createdAt = Int64(Date().timeIntervalSince1970)
+        ayuRegisterArchiveReservation(token)
+        return postbox.transaction { transaction -> Bool in
+            return ayuReserveViewOnceCopy(transaction: transaction, mediaBox: mediaBox, messageId: messageId,
+                                          fileId: fileId, token: token, expectedBytes: bytes, createdAt: createdAt)
+        }
+        |> deliverOn(Queue.concurrentDefaultQueue())
+        |> mapToSignal { reserved -> Signal<AyuBurnSnapshotReference?, NoError> in
+            guard reserved else { return .single(nil) }
+            guard let candidate = try? ayuPrepareArchiveSnapshot(media: media, mediaBox: mediaBox, archiveFileId: fileId,
+                                                                  reservationToken: token, maximumBytes: bytes),
+                  candidate.byteCount == bytes,
+                  let verified = AyuVerifiedArchiveSnapshot.verify(candidate, mediaBoxBasePath: mediaBox.basePath) else {
+                return ayuAbandonViewOnceReservation(postbox: postbox, fileId: fileId, token: token)
+                |> map { _ -> AyuBurnSnapshotReference? in return nil }
+            }
+            return postbox.transaction { transaction -> AyuBurnSnapshotReference? in
+                guard let archivedId = ayuCommitPreparedViewOnceCopy(transaction: transaction, mediaBox: mediaBox,
+                                                                      messageId: messageId, token: token, verified: verified),
+                      let reference = ayuPendingBurnReference(transaction: transaction, originalId: messageId, state: .committed),
+                      reference.archivedId == archivedId else { return nil }
+                return reference
+            }
+            |> mapToSignal { reference -> Signal<AyuBurnSnapshotReference?, NoError> in
+                if let reference { return .single(reference) }
+                return ayuAbandonViewOnceReservation(postbox: postbox, fileId: fileId, token: token)
+                |> map { _ -> AyuBurnSnapshotReference? in return nil }
+            }
+        }
+        |> afterNext { _ in
+            ayuReleaseArchiveReservation(token)
+        }
+    }
+}
diff --git a/submodules/TelegramCore/Sources/AyuPrivacy/AyuArchivedMedia.swift b/submodules/TelegramCore/Sources/AyuPrivacy/AyuArchivedMedia.swift
new file mode 100644
--- /dev/null
+++ b/submodules/TelegramCore/Sources/AyuPrivacy/AyuArchivedMedia.swift
@@ -0,0 +1,48 @@
+import Foundation
+import Postbox
+
+// Experimental models for independently stored snapshots. Their complete
+// lifecycle and playback still need verification on a real device.
+func ayuArchivedMediaCopy(_ media: Media, fileId: Int64, size: Int64, sha256: Data) -> Media? {
+    guard size > 0, sha256.count == 32 else { return nil }
+    let resource = AyuArchiveMediaResource(fileId: fileId, size: size, sha256: sha256)
+    if let image = media as? TelegramMediaImage,
+       let largest = largestImageRepresentation(image.representations) {
+        let mediaId = MediaId(namespace: Namespaces.Media.AyuArchivedImage, id: fileId)
+        guard image.imageId != mediaId, largest.resource.id != resource.id else { return nil }
+        let representation = TelegramMediaImageRepresentation(
+            dimensions: largest.dimensions,
+            resource: resource,
+            progressiveSizes: [],
+            immediateThumbnailData: largest.immediateThumbnailData,
+            hasVideo: false,
+            isPersonal: largest.isPersonal,
+            typeHint: .generic
+        )
+        return TelegramMediaImage(
+            imageId: mediaId,
+            representations: [representation],
+            immediateThumbnailData: image.immediateThumbnailData,
+            reference: nil,
+            partialReference: nil,
+            flags: image.flags
+        )
+    }
+    if let file = media as? TelegramMediaFile {
+        let mediaId = MediaId(namespace: Namespaces.Media.AyuArchivedFile, id: fileId)
+        guard file.fileId != mediaId, file.resource.id != resource.id else { return nil }
+        return TelegramMediaFile(
+            fileId: mediaId,
+            partialReference: nil,
+            resource: resource,
+            previewRepresentations: [],
+            videoThumbnails: [],
+            immediateThumbnailData: file.immediateThumbnailData,
+            mimeType: file.mimeType,
+            size: size,
+            attributes: file.attributes,
+            alternativeRepresentations: []
+        )
+    }
+    return nil
+}
diff --git a/submodules/TelegramCore/Sources/AyuPrivacy/AyuReadObservations.swift b/submodules/TelegramCore/Sources/AyuPrivacy/AyuReadObservations.swift
new file mode 100644
--- /dev/null
+++ b/submodules/TelegramCore/Sources/AyuPrivacy/AyuReadObservations.swift
@@ -0,0 +1,40 @@
+import Foundation
+import Postbox
+
+private let ayuReadObservationsKey = applicationSpecificPreferencesKey(900_002)
+
+private struct AyuReadRange: Codable {
+    let peerId: Int64
+    let afterId: Int32
+    let throughId: Int32
+    let observedAt: Int32
+}
+
+private struct AyuReadObservations: Codable {
+    var ranges: [AyuReadRange]
+}
+
+func recordAyuObservedReadRange(transaction: Transaction, accountPeerId: PeerId, messageId: MessageId, observedAt: Int32) {
+    guard ayuActivityPrivacySettings(transaction: transaction).saveReadDate,
+          messageId.peerId != accountPeerId, messageId.peerId.namespace == Namespaces.Peer.CloudUser,
+          messageId.namespace == Namespaces.Message.Cloud,
+          let combined = transaction.getCombinedPeerReadState(messageId.peerId),
+          let state = combined.states.first(where: { $0.0 == messageId.namespace })?.1 else { return }
+    guard case let .idBased(_, previous, _, _, _) = state, messageId.id > previous else { return }
+    transaction.updatePreferencesEntry(key: ayuReadObservationsKey, { current in
+        var observations = current?.get(AyuReadObservations.self) ?? AyuReadObservations(ranges: [])
+        observations.ranges.append(AyuReadRange(peerId: messageId.peerId.toInt64(), afterId: previous, throughId: messageId.id, observedAt: observedAt))
+        if observations.ranges.count > 2000 { observations.ranges.removeFirst(observations.ranges.count - 2000) }
+        return PreferencesEntry(observations)
+    })
+}
+
+func ayuReadRangeContains(afterId: Int32, throughId: Int32, messageId: Int32) -> Bool {
+    return messageId > afterId && messageId <= throughId
+}
+
+func ayuObservedReadDate(transaction: Transaction, messageId: MessageId) -> Int32? {
+    guard ayuActivityPrivacySettings(transaction: transaction).saveReadDate else { return nil }
+    let observations = transaction.getPreferencesEntry(key: ayuReadObservationsKey)?.get(AyuReadObservations.self)
+    return observations?.ranges.last(where: { $0.peerId == messageId.peerId.toInt64() && ayuReadRangeContains(afterId: $0.afterId, throughId: $0.throughId, messageId: messageId.id) })?.observedAt
+}
diff --git a/submodules/TelegramCore/Sources/AyuPrivacy/AyuViewOnceBurnRequest.swift b/submodules/TelegramCore/Sources/AyuPrivacy/AyuViewOnceBurnRequest.swift
new file mode 100644
--- /dev/null
+++ b/submodules/TelegramCore/Sources/AyuPrivacy/AyuViewOnceBurnRequest.swift
@@ -0,0 +1,64 @@
+import Foundation
+import Postbox
+import SwiftSignalKit
+internal import TelegramApi
+
+public enum AyuBurnAttemptResult: Equatable {
+    case notStarted
+    case uncertain
+    case acknowledged
+}
+
+// The caller verifies
+// the independent file before entering this function. A Postbox transaction
+// rechecks the original and commits burnInFlight before any request. A network
+// failure is ambiguous: keep the copy and never schedule an application-level
+// retry without reconciling the server result. Device and two-account checks
+// are required before considering this feature verified.
+func ayuSendPreparedViewOnceBurn(account: Account, verified: AyuVerifiedBurnSnapshot) -> Signal<AyuBurnAttemptResult, NoError> {
+    let reference = verified.reference
+    return account.postbox.transaction { transaction -> Bool in
+        return ayuBeginPreparedViewOnceBurn(transaction: transaction, verified: verified)
+    }
+    |> mapToSignal { started -> Signal<AyuBurnAttemptResult, NoError> in
+        guard started else { return .single(.notStarted) }
+        return account.network.request(Api.functions.messages.readMessageContents(id: [reference.originalId.id]), automaticFloodWait: false)
+        |> map(Optional.init)
+        |> `catch` { _ -> Signal<Api.messages.AffectedMessages?, NoError> in
+            return .single(nil)
+        }
+        |> mapToSignal { result -> Signal<AyuBurnAttemptResult, NoError> in
+            guard let result else { return .single(.uncertain) }
+            switch result {
+            case let .affectedMessages(data):
+                account.stateManager.addUpdateGroups([.updatePts(pts: data.pts, ptsCount: data.ptsCount)])
+            }
+            return account.postbox.transaction { transaction -> Bool in
+                guard ayuConfirmPreparedViewOnceBurn(transaction: transaction, reference: reference) else { return false }
+                // The server may not echo the read update to this client. Once
+                // the saved copy is committed, apply the same local expiry as
+                // an incoming read update without enqueuing a second request.
+                markMessageContentAsConsumedRemotely(transaction: transaction, messageId: reference.originalId, consumeDate: nil)
+                return true
+            }
+            |> map { saved -> AyuBurnAttemptResult in
+                return saved ? .acknowledged : .uncertain
+            }
+        }
+    }
+}
+
+// End-to-end coordinator.
+// The second verification happens off the Postbox queue immediately before
+// revalidating the source and persisting the in-flight request.
+func ayuAttemptViewOnceBurn(account: Account, messageId: MessageId) -> Signal<AyuBurnAttemptResult, NoError> {
+    return ayuPrepareViewOnceSnapshot(account: account, messageId: messageId)
+    |> deliverOn(Queue.concurrentDefaultQueue())
+    |> mapToSignal { reference -> Signal<AyuBurnAttemptResult, NoError> in
+        guard let reference,
+              let verified = AyuVerifiedBurnSnapshot.verify(reference, mediaBoxBasePath: account.postbox.mediaBox.basePath) else {
+            return .single(.notStarted)
+        }
+        return ayuSendPreparedViewOnceBurn(account: account, verified: verified)
+    }
+}
diff --git a/submodules/TelegramCore/Sources/Settings/DeletedMessageArchiveSettings.swift b/submodules/TelegramCore/Sources/Settings/DeletedMessageArchiveSettings.swift
new file mode 100644
--- /dev/null
+++ b/submodules/TelegramCore/Sources/Settings/DeletedMessageArchiveSettings.swift
@@ -0,0 +1,196 @@
+import Foundation
+import Postbox
+import SwiftSignalKit
+
+public struct DeletedMessageArchiveSettings: Codable, Equatable {
+    public static let defaultDeletedMessageMarker = "🧹"
+    public static let deletedMessageMarkerLimit = 32
+    // Positive values are the legacy GiB representation. Negative sentinels
+    // extend it without changing the stored keys or existing choices.
+    public static let limit300Megabytes: Int32 = -300
+    public static let unlimitedMediaLimit: Int32 = -1
+    public static let allowedMediaLimitGigabytes: [Int32] = [limit300Megabytes, 1, 2, 5, 10, 16, 20, 50, unlimitedMediaLimit]
+    public static let allowedDisappearingMediaLimitGigabytes: [Int32] = [limit300Megabytes, 1, 2, 5, 10, 16, unlimitedMediaLimit]
+    public static let defaultSettings = DeletedMessageArchiveSettings(
+        saveDeletedMessages: true,
+        saveEditedVersions: true,
+        deletedMessageMarker: DeletedMessageArchiveSettings.defaultDeletedMessageMarker,
+        keepAcrossLaunches: true,
+        mediaLimitGigabytes: 5,
+        disappearingMediaLimitGigabytes: 1,
+        sessionId: 0
+    )
+
+    public var saveDeletedMessages: Bool
+    public var saveEditedVersions: Bool
+    public var saveBotDialogs: Bool
+    public var deletedMessageMarker: String
+    public var translucentDeletedMessages: Bool
+    public var keepAcrossLaunches: Bool
+    public var mediaLimitGigabytes: Int32
+    public var disappearingMediaLimitGigabytes: Int32
+    public var sessionId: Int64
+
+    public var isEnabled: Bool {
+        get {
+            return self.saveDeletedMessages || self.saveEditedVersions
+        }
+        set {
+            self.saveDeletedMessages = newValue
+            self.saveEditedVersions = newValue
+        }
+    }
+
+    public var effectiveDeletedMessageMarker: String {
+        return DeletedMessageArchiveSettings.normalizedDeletedMessageMarker(self.deletedMessageMarker)
+    }
+
+    public static func bytesForMediaLimit(_ value: Int32) -> Int64? {
+        if value == limit300Megabytes { return 300 * 1024 * 1024 }
+        if value == unlimitedMediaLimit { return Int64.max }
+        guard allowedMediaLimitGigabytes.contains(value) || allowedDisappearingMediaLimitGigabytes.contains(value), value > 0 else { return nil }
+        return Int64(value) * 1024 * 1024 * 1024
+    }
+
+    public var mediaLimitBytes: Int64 {
+        return Self.bytesForMediaLimit(self.mediaLimitGigabytes) ?? 0
+    }
+
+    public var disappearingMediaLimitBytes: Int64 {
+        return Self.bytesForMediaLimit(self.disappearingMediaLimitGigabytes) ?? 0
+    }
+
+    public static func normalizedDeletedMessageMarker(_ value: String) -> String {
+        let trimmed = value.trimmingCharacters(in: .whitespacesAndNewlines)
+        if trimmed.isEmpty {
+            return DeletedMessageArchiveSettings.defaultDeletedMessageMarker
+        }
+        return String(trimmed.prefix(DeletedMessageArchiveSettings.deletedMessageMarkerLimit))
+    }
+
+    public init(
+        saveDeletedMessages: Bool,
+        saveEditedVersions: Bool,
+        deletedMessageMarker: String,
+        keepAcrossLaunches: Bool,
+        mediaLimitGigabytes: Int32,
+        disappearingMediaLimitGigabytes: Int32,
+        sessionId: Int64,
+        translucentDeletedMessages: Bool = true,
+        saveBotDialogs: Bool = true
+    ) {
+        self.saveDeletedMessages = saveDeletedMessages
+        self.saveEditedVersions = saveEditedVersions
+        self.saveBotDialogs = saveBotDialogs
+        self.deletedMessageMarker = String(deletedMessageMarker.prefix(DeletedMessageArchiveSettings.deletedMessageMarkerLimit))
+        self.translucentDeletedMessages = translucentDeletedMessages
+        self.keepAcrossLaunches = keepAcrossLaunches
+        self.mediaLimitGigabytes = DeletedMessageArchiveSettings.allowedMediaLimitGigabytes.contains(mediaLimitGigabytes) ? mediaLimitGigabytes : 5
+        self.disappearingMediaLimitGigabytes = DeletedMessageArchiveSettings.allowedDisappearingMediaLimitGigabytes.contains(disappearingMediaLimitGigabytes) ? disappearingMediaLimitGigabytes : 1
+        self.sessionId = sessionId
+    }
+
+    public init(from decoder: Decoder) throws {
+        let container = try decoder.container(keyedBy: CodingKeys.self)
+        let legacyIsEnabled = try container.decodeIfPresent(Bool.self, forKey: .isEnabled) ?? true
+        self.init(
+            saveDeletedMessages: try container.decodeIfPresent(Bool.self, forKey: .saveDeletedMessages) ?? legacyIsEnabled,
+            saveEditedVersions: try container.decodeIfPresent(Bool.self, forKey: .saveEditedVersions) ?? legacyIsEnabled,
+            deletedMessageMarker: try container.decodeIfPresent(String.self, forKey: .deletedMessageMarker) ?? DeletedMessageArchiveSettings.defaultDeletedMessageMarker,
+            keepAcrossLaunches: try container.decode(Bool.self, forKey: .keepAcrossLaunches),
+            mediaLimitGigabytes: try container.decode(Int32.self, forKey: .mediaLimitGigabytes),
+            disappearingMediaLimitGigabytes: try container.decodeIfPresent(Int32.self, forKey: .disappearingMediaLimitGigabytes) ?? 1,
+            sessionId: try container.decode(Int64.self, forKey: .sessionId),
+            translucentDeletedMessages: try container.decodeIfPresent(Bool.self, forKey: .translucentDeletedMessages) ?? true,
+            saveBotDialogs: try container.decodeIfPresent(Bool.self, forKey: .saveBotDialogs) ?? true
+        )
+    }
+
+    public func encode(to encoder: Encoder) throws {
+        var container = encoder.container(keyedBy: CodingKeys.self)
+        try container.encode(self.isEnabled, forKey: .isEnabled)
+        try container.encode(self.saveDeletedMessages, forKey: .saveDeletedMessages)
+        try container.encode(self.saveEditedVersions, forKey: .saveEditedVersions)
+        try container.encode(self.saveBotDialogs, forKey: .saveBotDialogs)
+        try container.encode(self.deletedMessageMarker, forKey: .deletedMessageMarker)
+        try container.encode(self.translucentDeletedMessages, forKey: .translucentDeletedMessages)
+        try container.encode(self.keepAcrossLaunches, forKey: .keepAcrossLaunches)
+        try container.encode(self.mediaLimitGigabytes, forKey: .mediaLimitGigabytes)
+        try container.encode(self.disappearingMediaLimitGigabytes, forKey: .disappearingMediaLimitGigabytes)
+        try container.encode(self.sessionId, forKey: .sessionId)
+    }
+
+    private enum CodingKeys: String, CodingKey {
+        case isEnabled
+        case saveDeletedMessages
+        case saveEditedVersions
+        case saveBotDialogs
+        case deletedMessageMarker
+        case translucentDeletedMessages
+        case keepAcrossLaunches
+        case mediaLimitGigabytes
+        case disappearingMediaLimitGigabytes
+        case sessionId
+    }
+}
+
+struct DeletedMessageArchiveIndexEntry: Codable, Hashable {
+    let peerId: Int64
+    let namespace: Int32
+    let id: Int32
+
+    init(_ id: MessageId) {
+        self.peerId = id.peerId.toInt64()
+        self.namespace = id.namespace
+        self.id = id.id
+    }
+
+    var messageId: MessageId {
+        return MessageId(peerId: PeerId(self.peerId), namespace: self.namespace, id: self.id)
+    }
+}
+
+struct DeletedMessageArchiveIndex: Codable, Equatable {
+    var messageIds: [DeletedMessageArchiveIndexEntry]
+    var liveMessageIds: [DeletedMessageArchiveIndexEntry]
+
+    static let empty = DeletedMessageArchiveIndex(messageIds: [], liveMessageIds: [])
+
+    private enum CodingKeys: String, CodingKey {
+        case messageIds
+        case liveMessageIds
+    }
+
+    init(messageIds: [DeletedMessageArchiveIndexEntry], liveMessageIds: [DeletedMessageArchiveIndexEntry]) {
+        self.messageIds = messageIds
+        self.liveMessageIds = liveMessageIds
+    }
+
+    init(from decoder: Decoder) throws {
+        let container = try decoder.container(keyedBy: CodingKeys.self)
+        self.messageIds = try container.decodeIfPresent([DeletedMessageArchiveIndexEntry].self, forKey: .messageIds) ?? []
+        self.liveMessageIds = try container.decodeIfPresent([DeletedMessageArchiveIndexEntry].self, forKey: .liveMessageIds) ?? []
+    }
+}
+
+func deletedMessageArchiveSettings(transaction: Transaction) -> DeletedMessageArchiveSettings {
+    return transaction.getPreferencesEntry(key: PreferencesKeys.deletedMessageArchiveSettings)?.get(DeletedMessageArchiveSettings.self) ?? .defaultSettings
+}
+
+func updateDeletedMessageArchiveIndex(transaction: Transaction, _ f: (DeletedMessageArchiveIndex) -> DeletedMessageArchiveIndex) {
+    transaction.updatePreferencesEntry(key: PreferencesKeys.deletedMessageArchiveIndex, { current in
+        return PreferencesEntry(f(current?.get(DeletedMessageArchiveIndex.self) ?? .empty))
+    })
+}
+
+public func updateDeletedMessageArchiveSettingsInteractively(
+    postbox: Postbox,
+    _ f: @escaping (DeletedMessageArchiveSettings) -> DeletedMessageArchiveSettings
+) -> Signal<Never, NoError> {
+    return postbox.transaction { transaction -> Void in
+        transaction.updatePreferencesEntry(key: PreferencesKeys.deletedMessageArchiveSettings, { current in
+            return PreferencesEntry(f(current?.get(DeletedMessageArchiveSettings.self) ?? .defaultSettings))
+        })
+    }
+    |> ignoreValues
+}
diff --git a/submodules/TelegramCore/Sources/Settings/GhostModeSettings.swift b/submodules/TelegramCore/Sources/Settings/GhostModeSettings.swift
new file mode 100644
