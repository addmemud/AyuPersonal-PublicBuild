diff --git a/Ayu/tools/project.py b/Ayu/tools/project.py
new file mode 100755
--- /dev/null
+++ b/Ayu/tools/project.py
@@ -0,0 +1,198 @@
+#!/usr/bin/env python3
+"""Local setup for Ayu Personal. Never uploads credentials or changes the OS."""
+from __future__ import annotations
+
+import argparse
+import getpass
+import json
+import os
+from pathlib import Path
+import platform
+import re
+import secrets
+import shutil
+import subprocess
+import sys
+import tempfile
+
+ROOT = Path(__file__).resolve().parents[2]
+CONFIG = ROOT / "Ayu" / "local" / "configuration.json"
+
+
+def run(args: list[str], *, cwd: Path = ROOT) -> None:
+    subprocess.run(args, cwd=cwd, check=True)
+
+
+def output(args: list[str]) -> str:
+    return subprocess.check_output(args, cwd=ROOT, text=True, stderr=subprocess.STDOUT).strip()
+
+
+def versions() -> dict:
+    return json.loads((ROOT / "versions.json").read_text(encoding="utf-8"))
+
+
+def validate_config(config: dict) -> None:
+    api_id = str(config.get("api_id", ""))
+    if not api_id.isascii() or not api_id.isdecimal() or not 0 < int(api_id) <= 2**31 - 1:
+        raise ValueError("Telegram API ID должен быть положительным числом Int32.")
+    if not re.fullmatch(r"[0-9a-fA-F]{32}", config.get("api_hash", "")):
+        raise ValueError("Telegram API hash должен содержать 32 шестнадцатеричных символа.")
+    if not re.fullmatch(r"[A-Z0-9]{10}", config.get("team_id", "")):
+        raise ValueError("Apple Team ID должен содержать 10 латинских букв/цифр.")
+    bundle_id = config.get("bundle_id", "")
+    if not re.fullmatch(r"[A-Za-z0-9-]+(?:\.[A-Za-z0-9-]+){2,}", bundle_id):
+        raise ValueError("Некорректный Bundle ID.")
+    if bundle_id == "ph.telegra.Telegraph":
+        raise ValueError("Для личного приложения нужен отдельный Bundle ID.")
+
+
+def doctor(*, verbose: bool = True) -> bool:
+    required = versions()
+    checks: list[tuple[bool, str]] = []
+    checks.append((shutil.which("git") is not None, "Git"))
+    is_mac = platform.system() == "Darwin"
+    checks.append((is_mac, "macOS для штатной сборки Telegram iOS"))
+    if is_mac:
+        xcode = shutil.which("xcodebuild")
+        checks.append((xcode is not None, "Xcode установлен"))
+        if xcode:
+            try:
+                installed = output([xcode, "-version"]).splitlines()[0].removeprefix("Xcode ")
+                checks.append((installed == required["xcode"], f"Xcode {installed}; проект требует {required['xcode']}"))
+                output(["xcrun", "--sdk", "iphoneos", "--show-sdk-path"])
+                checks.append((True, "iPhoneOS SDK"))
+            except (subprocess.CalledProcessError, OSError):
+                checks.append((False, "Xcode/SDK ещё не настроен владельцем Mac"))
+    if verbose:
+        print(f"Ayu Personal · Telegram {required['app']} · Python {sys.version.split()[0]}")
+        for passed, label in checks:
+            print(f"{'OK' if passed else 'НЕТ'}: {label}")
+        print("Локальный конфиг:", "есть" if CONFIG.exists() else "ещё не создан")
+        if not is_mac:
+            print("На Windows доступны исходники и тесты модели через WSL. Сборка Telegram через xtool пока не подтверждена.")
+    return all(passed for passed, _ in checks)
+
+
+def configure() -> None:
+    if CONFIG.exists():
+        validate_config(json.loads(CONFIG.read_text(encoding="utf-8")))
+        print("Конфиг уже существует; сохранён без изменений. Bundle ID менять не нужно.")
+        return
+    print("Введи данные локально. Пароль Apple Account и коды подтверждения здесь не нужны.")
+    config = json.loads((ROOT / "build-system/template_minimal_development_configuration.json").read_text(encoding="utf-8"))
+    config.update({
+        "api_id": input("Telegram API ID (my.telegram.org/apps): ").strip(),
+        "api_hash": getpass.getpass("Telegram API hash (ввод скрыт): ").strip(),
+        "team_id": input("Apple Team ID (10 символов): ").strip().upper(),
+        "bundle_id": "org.ayupersonal.app" + secrets.token_hex(4),
+        "app_specific_url_scheme": "ayupersonal",
+        "is_internal_build": "false",
+        "is_appstore_build": "false",
+        "enable_siri": False,
+        "enable_icloud": False,
+    })
+    validate_config(config)
+    CONFIG.parent.mkdir(parents=True, exist_ok=True)
+    # Refuse an overwrite, including a concurrent configure on the same project.
+    with CONFIG.open("x", encoding="utf-8") as file:
+        os.chmod(CONFIG, 0o600)
+        json.dump(config, file, ensure_ascii=False, indent=2)
+        file.write("\n")
+    print("Конфиг сохранён локально; Git его игнорирует.")
+
+
+def prepare(args: argparse.Namespace) -> None:
+    if not doctor():
+        raise ValueError("Сначала устрани отмеченные пункты. Скрипт ничего не устанавливает автоматически.")
+    if not CONFIG.is_file():
+        raise ValueError("Сначала выполни: python3 Ayu/tools/project.py configure")
+    validate_config(json.loads(CONFIG.read_text(encoding="utf-8")))
+    cache = Path(args.cache_dir or os.environ.get("AYU_CACHE_DIR", "~/Library/Caches/AyuPersonal")).expanduser().resolve()
+    cache.mkdir(parents=True, exist_ok=True)
+    run(["git", "submodule", "sync", "--recursive"])
+    run(["git", "submodule", "update", "--init", "--recursive", "--jobs", "4"])
+    command = [sys.executable, "build-system/Make/Make.py", "--cacheDir", str(cache), "generateProject", "--configurationPath", str(CONFIG), "--xcodeManagedCodesigning", "--disableExtensions"]
+    if args.simulator:
+        command.append("--disableProvisioningProfiles")
+    run(command)
+    projects = sorted(ROOT.glob("Telegram/*.xcodeproj"))
+    if projects:
+        print("Открой в Xcode:")
+        for project in projects:
+            print(project)
+    else:
+        print("Путь Xcode-проекта смотри в выводе Make.py выше.")
+    print("Проект подготовлен. Приложение ещё не собрано; в Xcode выбери команду, устройство и Run.")
+
+
+def policy_test_command(temporary: Path) -> list[str]:
+    if platform.system() == "Darwin":
+        xcrun = shutil.which("xcrun")
+        if not xcrun:
+            raise ValueError("Для тестов на Mac нужен Xcode с xcrun.")
+        return [xcrun, "--sdk", "macosx", "swift", "test", "--package-path", str(temporary)]
+    swiftc = shutil.which("swiftc")
+    if not swiftc:
+        raise ValueError("Для тестов нужен Swift: на Mac вместе с Xcode, на Linux/WSL — swift.org/install.")
+    return [swiftc, "-warnings-as-errors", "submodules/TelegramCore/Sources/AyuPrivacy/AyuActivityPrivacySettings.swift",
+            "Ayu/Tests/PrivacyPolicy/ActivityPrivacyTests.swift", "Ayu/Tests/PrivacyPolicy/main.swift",
+            "-o", str(temporary / "privacy-policy-tests")]
+
+
+def test_policy() -> None:
+    with tempfile.TemporaryDirectory(prefix="ayu-policy-") as temporary:
+        package = Path(temporary)
+        if platform.system() == "Darwin":
+            # Apple XCTest has no corelibs XCTMain entry point. SwiftPM supplies
+            # its native macOS test runner and Xcode testing search paths.
+            (package / "Tests").mkdir()
+            (package / "Package.swift").write_text(
+                '// swift-tools-version: 5.9\nimport PackageDescription\n'
+                'let package = Package(name: "AyuPrivacy", targets: [\n'
+                '    .testTarget(name: "AyuPrivacyTests", path: "Tests")\n])\n', encoding="utf-8")
+            shutil.copyfile(ROOT / "submodules/TelegramCore/Sources/AyuPrivacy/AyuActivityPrivacySettings.swift",
+                            package / "Tests/AyuActivityPrivacySettings.swift")
+            shutil.copyfile(ROOT / "Ayu/Tests/PrivacyPolicy/ActivityPrivacyTests.swift", package / "Tests/ActivityPrivacyTests.swift")
+        run(policy_test_command(package))
+        if platform.system() != "Darwin":
+            run([str(package / "privacy-policy-tests")])
+
+
+def main() -> int:
+    # Windows pipes can default to a legacy code page without Cyrillic support.
+    # Keep the CLI readable when redirected or launched by an editor as well.
+    if platform.system() == "Windows":
+        for stream in (sys.stdout, sys.stderr):
+            if hasattr(stream, "reconfigure"):
+                stream.reconfigure(encoding="utf-8", errors="replace")
+    parser = argparse.ArgumentParser(description=__doc__)
+    commands = parser.add_subparsers(dest="command", required=True)
+    commands.add_parser("doctor", help="Проверить среду без изменений")
+    commands.add_parser("configure", help="Создать приватный локальный конфиг")
+    commands.add_parser("test-policy", help="Скомпилировать и проверить модель приватности")
+    prepare_parser = commands.add_parser("prepare", help="Подготовить Xcode-проект на Mac")
+    prepare_parser.add_argument("--simulator", action="store_true")
+    prepare_parser.add_argument("--cache-dir")
+    args = parser.parse_args()
+    try:
+        if args.command == "doctor":
+            return 0 if doctor() else 2
+        if args.command == "configure":
+            configure()
+        elif args.command == "prepare":
+            prepare(args)
+        elif args.command == "test-policy":
+            test_policy()
+    except (ValueError, OSError, subprocess.CalledProcessError, KeyboardInterrupt) as error:
+        if isinstance(error, subprocess.CalledProcessError):
+            print(f"Команда завершилась с кодом {error.returncode}; детали выше.", file=sys.stderr)
+        elif isinstance(error, KeyboardInterrupt):
+            print("Остановлено пользователем.", file=sys.stderr)
+        else:
+            print(str(error), file=sys.stderr)
+        return 1
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
