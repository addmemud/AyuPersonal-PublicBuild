@@ -0,0 +1,144 @@
+import Foundation
+
+/// Per-account local privacy options. These do not hide read receipts or live drafts.
+/// Other actions and other clients may reveal presence; this is not a complete ghost mode.
+public struct AyuActivityPrivacySettings: Codable, Equatable {
+    public enum Option: CaseIterable {
+        case typing
+        case recording
+        case uploads
+        case interactions
+        case storyViews
+        case onlinePresence
+        case sponsoredMessages
+        case readDate
+        case lastActivity
+        case silentByDefault
+        case scheduleByDefault
+    }
+
+    public enum Activity: CaseIterable {
+        case typing
+        case recordingVoice
+        case recordingVideo
+        case uploadingFile
+        case uploadingPhoto
+        case uploadingVideo
+        case uploadingVideoMessage
+        case playingGame
+        case choosingSticker
+        case interactingWithEmoji
+        case seeingEmojiInteraction
+        case speakingInGroupCall
+        case cancel
+    }
+
+    public static var defaultSettings: AyuActivityPrivacySettings {
+        return AyuActivityPrivacySettings()
+    }
+
+    public var hideTyping: Bool
+    public var hideRecording: Bool
+    public var hideUploads: Bool
+    public var hideInteractions: Bool
+    public var hideStoryViews: Bool
+    public var hideOnlinePresence: Bool
+    public var hideSponsoredMessages: Bool
+    public var saveReadDate: Bool
+    public var showLastActivityEstimate: Bool
+    public var silentByDefault: Bool
+    public var scheduleByDefault: Bool
+
+    public init(hideTyping: Bool = false, hideRecording: Bool = false, hideUploads: Bool = false, hideInteractions: Bool = false, hideStoryViews: Bool = false, hideOnlinePresence: Bool = false, hideSponsoredMessages: Bool = false, saveReadDate: Bool = true, showLastActivityEstimate: Bool = true, silentByDefault: Bool = false, scheduleByDefault: Bool = false) {
+        self.hideTyping = hideTyping
+        self.hideRecording = hideRecording
+        self.hideUploads = hideUploads
+        self.hideInteractions = hideInteractions
+        self.hideStoryViews = hideStoryViews
+        self.hideOnlinePresence = hideOnlinePresence
+        self.hideSponsoredMessages = hideSponsoredMessages
+        self.saveReadDate = saveReadDate
+        self.showLastActivityEstimate = showLastActivityEstimate
+        self.silentByDefault = silentByDefault
+        self.scheduleByDefault = scheduleByDefault
+    }
+
+    private enum CodingKeys: String, CodingKey {
+        case hideTyping
+        case hideRecording
+        case hideUploads
+        case hideInteractions
+        case hideStoryViews
+        case hideOnlinePresence
+        case hideSponsoredMessages
+        case saveReadDate
+        case showLastActivityEstimate
+        case silentByDefault
+        case scheduleByDefault
+    }
+
+    public init(from decoder: Decoder) throws {
+        let values = try decoder.container(keyedBy: CodingKeys.self)
+        self.hideTyping = try values.decodeIfPresent(Bool.self, forKey: .hideTyping) ?? false
+        self.hideRecording = try values.decodeIfPresent(Bool.self, forKey: .hideRecording) ?? false
+        self.hideUploads = try values.decodeIfPresent(Bool.self, forKey: .hideUploads) ?? false
+        self.hideInteractions = try values.decodeIfPresent(Bool.self, forKey: .hideInteractions) ?? false
+        self.hideStoryViews = try values.decodeIfPresent(Bool.self, forKey: .hideStoryViews) ?? false
+        self.hideOnlinePresence = try values.decodeIfPresent(Bool.self, forKey: .hideOnlinePresence) ?? false
+        self.hideSponsoredMessages = try values.decodeIfPresent(Bool.self, forKey: .hideSponsoredMessages) ?? false
+        self.saveReadDate = try values.decodeIfPresent(Bool.self, forKey: .saveReadDate) ?? true
+        self.showLastActivityEstimate = try values.decodeIfPresent(Bool.self, forKey: .showLastActivityEstimate) ?? true
+        self.silentByDefault = try values.decodeIfPresent(Bool.self, forKey: .silentByDefault) ?? false
+        self.scheduleByDefault = try values.decodeIfPresent(Bool.self, forKey: .scheduleByDefault) ?? false
+    }
+
+    public func value(for option: Option) -> Bool {
+        switch option {
+        case .typing: return self.hideTyping
+        case .recording: return self.hideRecording
+        case .uploads: return self.hideUploads
+        case .interactions: return self.hideInteractions
+        case .storyViews: return self.hideStoryViews
+        case .onlinePresence: return self.hideOnlinePresence
+        case .sponsoredMessages: return self.hideSponsoredMessages
+        case .readDate: return self.saveReadDate
+        case .lastActivity: return self.showLastActivityEstimate
+        case .silentByDefault: return self.silentByDefault
+        case .scheduleByDefault: return self.scheduleByDefault
+        }
+    }
+
+    public func withUpdated(_ option: Option, value: Bool) -> AyuActivityPrivacySettings {
+        var result = self
+        switch option {
+        case .typing: result.hideTyping = value
+        case .recording: result.hideRecording = value
+        case .uploads: result.hideUploads = value
+        case .interactions: result.hideInteractions = value
+        case .storyViews: result.hideStoryViews = value
+        case .onlinePresence: result.hideOnlinePresence = value
+        case .sponsoredMessages: result.hideSponsoredMessages = value
+        case .readDate: result.saveReadDate = value
+        case .lastActivity: result.showLastActivityEstimate = value
+        case .silentByDefault: result.silentByDefault = value
+        case .scheduleByDefault: result.scheduleByDefault = value
+        }
+        return result
+    }
+
+    public func suppresses(_ activity: Activity) -> Bool {
+        switch activity {
+        case .typing:
+            return self.hideTyping
+        case .recordingVoice, .recordingVideo:
+            return self.hideRecording
+        case .uploadingFile, .uploadingPhoto, .uploadingVideo, .uploadingVideoMessage:
+            return self.hideUploads
+        case .playingGame, .choosingSticker, .interactingWithEmoji, .seeingEmojiInteraction:
+            return self.hideInteractions
+        case .speakingInGroupCall, .cancel:
+            // Do not break call signalling or prevent a prior activity from ending.
+            return false
+        }
+    }
+}
diff --git a/submodules/TelegramCore/Sources/AyuPrivacy/AyuActivityPrivacyStorage.swift b/submodules/TelegramCore/Sources/AyuPrivacy/AyuActivityPrivacyStorage.swift
new file mode 100644
