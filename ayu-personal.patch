+++ b/Ayu/Tests/PrivacyPolicy/ActivityPrivacyTests.swift
@@ -0,0 +1,88 @@
+import Foundation
+import XCTest
+
+final class ActivityPrivacyTests: XCTestCase {
+    func testDefaultDoesNotChangeAnyActivity() {
+        for activity in AyuActivityPrivacySettings.Activity.allCases {
+            XCTAssertFalse(AyuActivityPrivacySettings.defaultSettings.suppresses(activity), "\(activity)")
+        }
+    }
+
+    func testEnabledSettingsLeaveCallsAndCancellationWorking() {
+        let settings = AyuActivityPrivacySettings(hideTyping: true, hideRecording: true, hideUploads: true, hideInteractions: true)
+        for activity in AyuActivityPrivacySettings.Activity.allCases {
+            let isExempt = activity == .speakingInGroupCall || activity == .cancel
+            XCTAssertEqual(settings.suppresses(activity), !isExempt, "\(activity)")
+        }
+    }
+
+    func testEachSwitchOnlySuppressesItsOwnActivities() {
+        let cases: [(AyuActivityPrivacySettings.Option, [AyuActivityPrivacySettings.Activity])] = [
+            (.typing, [.typing]),
+            (.recording, [.recordingVoice, .recordingVideo]),
+            (.uploads, [.uploadingFile, .uploadingPhoto, .uploadingVideo, .uploadingVideoMessage]),
+            (.interactions, [.playingGame, .choosingSticker, .interactingWithEmoji, .seeingEmojiInteraction])
+        ]
+        for (option, expected) in cases {
+            let settings = AyuActivityPrivacySettings.defaultSettings.withUpdated(option, value: true)
+            for activity in AyuActivityPrivacySettings.Activity.allCases {
+                XCTAssertEqual(settings.suppresses(activity), expected.contains(activity), "\(option): \(activity)")
+            }
+        }
+    }
+
+    func testUpdatingOneSwitchPreservesTheOtherSwitches() {
+        var settings = AyuActivityPrivacySettings.defaultSettings
+        for option in AyuActivityPrivacySettings.Option.allCases {
+            settings = settings.withUpdated(option, value: true)
+        }
+        let updated = settings.withUpdated(.recording, value: false)
+        XCTAssertTrue(updated.hideTyping)
+        XCTAssertFalse(updated.hideRecording)
+        XCTAssertTrue(updated.hideUploads)
+        XCTAssertTrue(updated.hideInteractions)
+        XCTAssertTrue(settings.hideRecording)
+    }
+
+    func testPartialOlderSettingsKeepNewOptionsAtDefaults() throws {
+        let data = Data("{\"hideTyping\":true}".utf8)
+        let settings = try JSONDecoder().decode(AyuActivityPrivacySettings.self, from: data)
+        XCTAssertTrue(settings.hideTyping)
+        XCTAssertFalse(settings.hideRecording)
+        XCTAssertFalse(settings.hideUploads)
+        XCTAssertFalse(settings.hideInteractions)
+    }
+
+    func testAddedPreferencesRoundTripAndLegacyDefaults() throws {
+        let legacy = try JSONDecoder().decode(AyuActivityPrivacySettings.self, from: Data("{}".utf8))
+        XCTAssertTrue(legacy.saveReadDate)
+        XCTAssertTrue(legacy.showLastActivityEstimate)
+        XCTAssertFalse(legacy.hideSponsoredMessages)
+        XCTAssertFalse(legacy.silentByDefault)
+        XCTAssertFalse(legacy.scheduleByDefault)
+        var settings = legacy.withUpdated(.readDate, value: false)
+        settings = settings.withUpdated(.lastActivity, value: false)
+        settings = settings.withUpdated(.sponsoredMessages, value: true)
+        settings = settings.withUpdated(.silentByDefault, value: true)
+        settings = settings.withUpdated(.scheduleByDefault, value: true)
+        let restored = try JSONDecoder().decode(AyuActivityPrivacySettings.self, from: JSONEncoder().encode(settings))
+        XCTAssertEqual(restored, settings)
+    }
+
+    func testSettingsRoundTrip() throws {
+        for bits in 0..<16 {
+            let settings = AyuActivityPrivacySettings(hideTyping: bits & 1 != 0, hideRecording: bits & 2 != 0, hideUploads: bits & 4 != 0, hideInteractions: bits & 8 != 0)
+            XCTAssertEqual(try JSONDecoder().decode(AyuActivityPrivacySettings.self, from: JSONEncoder().encode(settings)), settings)
+        }
+    }
+
+    func testUnknownFieldsDoNotEraseKnownPreferences() throws {
+        let data = Data("{\"hideTyping\":true,\"futureOption\":42}".utf8)
+        let settings = try JSONDecoder().decode(AyuActivityPrivacySettings.self, from: data)
+        XCTAssertTrue(settings.hideTyping)
+    }
+
+    func testInvalidTypesAreRejected() {
+        XCTAssertThrowsError(try JSONDecoder().decode(AyuActivityPrivacySettings.self, from: Data("{\"hideTyping\":\"yes\"}".utf8)))
+    }
+}
