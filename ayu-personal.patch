+"""Project generation must preserve explicit provisioning settings in both phases."""
+import importlib.util
+from pathlib import Path
+import sys
+from types import SimpleNamespace
+import unittest
+from unittest.mock import mock_open, patch
+
+MAKE = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(MAKE))
+SPEC = importlib.util.spec_from_file_location("ayu_project_generation", MAKE / "ProjectGeneration.py")
+project_generation = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(project_generation)
+
+
+class ProjectGenerationTests(unittest.TestCase):
+    def generate(self, target, disable_profiles):
+        environment = SimpleNamespace(base_path="unused-test-root", bazel_path="bazel-test")
+        writer = mock_open()
+        with patch.object(project_generation, "call_executable") as run, \
+                patch.object(project_generation.os.path, "isfile", return_value=False), \
+                patch.object(project_generation, "open", writer, create=True):
+            project_generation.generate_xcodeproj(
+                environment, True, disable_profiles, False, False,
+                ["--define=buildNumber=1"], target,
+            )
+        arguments = run.call_args.args[0]
+        config = "".join(call.args[0] for call in writer().write.call_args_list)
+        return arguments, config
+
+    def test_no_profiles_flag_reaches_generation_and_generated_build(self):
+        arguments, config = self.generate("Telegram", True)
+        self.assertIn("--//Telegram:disableProvisioningProfiles", arguments)
+        self.assertIn("build --//Telegram:disableProvisioningProfiles\n", config)
+
+    def test_device_profiles_remain_enabled_by_default(self):
+        arguments, config = self.generate("Telegram", False)
+        self.assertFalse(any("disableProvisioningProfiles" in item for item in arguments))
+        self.assertNotIn("disableProvisioningProfiles", config)
+
+    def test_other_targets_do_not_receive_telegram_settings(self):
+        arguments, config = self.generate("Tests/ComposerHarness", True)
+        self.assertFalse(any("disableProvisioningProfiles" in item for item in arguments))
+        self.assertNotIn("disableProvisioningProfiles", config)
+
+
+if __name__ == "__main__":
+    unittest.main()
