+import Foundation
+import Postbox
+import SwiftSignalKit
+
+private let deletedMessageArchiveSessionId = Int64.random(in: Int64.min ... Int64.max)
+
+private struct DeletedMessageArchiveKeptResourceKey: Hashable {
+    let mediaBoxPath: String
+    let resourceId: MediaResourceId
+}
+
+private let deletedMessageArchiveMediaKeepDisposables = Atomic<[DeletedMessageArchiveKeptResourceKey: Disposable]>(value: [:])
+private let deletedMessageArchiveSessionInitialized = Atomic<Bool>(value: false)
+
+private func archiveTimestamp() -> Int32 {
+    return Int32(Date().timeIntervalSince1970)
+}
+
+private func removeDeletedMessageArchiveMetadata(transaction: Transaction, ids: [MessageId]) {
+    for id in ids {
+        transaction.updateMessage(id, update: { currentMessage in
+            let attributes = attributesWithoutArchiveMetadata(currentMessage.attributes)
+            if attributes.count == currentMessage.attributes.count {
+                return .skip
+            }
+            return .update(StoreMessage(
+                id: currentMessage.id,
+                customStableId: nil,
+                globallyUniqueId: currentMessage.globallyUniqueId,
+                groupingKey: currentMessage.groupingKey,
+                threadId: currentMessage.threadId,
+                timestamp: currentMessage.timestamp,
+                flags: StoreMessageFlags(currentMessage.flags),
+                tags: currentMessage.tags,
+                globalTags: currentMessage.globalTags,
+                localTags: currentMessage.localTags,
+                forwardInfo: currentMessage.forwardInfo.flatMap(StoreMessageForwardInfo.init),
+                authorId: currentMessage.author?.id,
+                text: currentMessage.text,
+                attributes: attributes,
+                media: currentMessage.media
+            ))
+        })
+    }
+}
+
+private func prepareDeletedMessageArchive(transaction: Transaction, mediaBox: MediaBox? = nil) -> DeletedMessageArchiveSettings? {
+    guard deletedMessageArchiveSessionInitialized.with({ $0 }) else {
+        return nil
+    }
+    var settings = deletedMessageArchiveSettings(transaction: transaction)
+    if settings.sessionId != deletedMessageArchiveSessionId {
+        if settings.sessionId != 0 && !settings.keepAcrossLaunches {
+            // Durable files must first be marked for deletion in the same
+            // session-initialization transaction. Never orphan an unmarked
+            // copy if another transaction arrives before initialization.
+            guard ayuCanDiscardArchiveCopies(transaction: transaction),
+                  let journal = ayuArchiveJournal(transaction: transaction),
+                  journal.entries.allSatisfy({ $0.state == .deleting }) else { return nil }
+            let index = transaction.getPreferencesEntry(key: PreferencesKeys.deletedMessageArchiveIndex)?.get(DeletedMessageArchiveIndex.self) ?? .empty
+            var resourceIds = Set<MediaResourceId>()
+            for entry in index.messageIds {
+                if let message = transaction.getMessage(entry.messageId) {
+                    resourceIds.formUnion(archivedResourceIds(message))
+                }
+            }
+            if let mediaBox, !resourceIds.isEmpty {
+                let _ = mediaBox.removeCachedResources(Array(resourceIds), force: true).start()
+            }
+            transaction.deleteMessages(index.messageIds.map(\.messageId), forEachMedia: nil)
+            removeDeletedMessageArchiveMetadata(transaction: transaction, ids: index.liveMessageIds.map(\.messageId))
+            updateDeletedMessageArchiveIndex(transaction: transaction, { _ in .empty })
+        }
+        settings.sessionId = deletedMessageArchiveSessionId
+        transaction.updatePreferencesEntry(key: PreferencesKeys.deletedMessageArchiveSettings, { _ in
+            return PreferencesEntry(settings)
+        })
+    }
+    return settings
+}
+
+private func archivedResourceIds(_ message: Message) -> [MediaResourceId] {
+    var result: [MediaResourceId] = []
+
+    func append(_ media: Media) {
+        addMessageMediaResourceIdsToRemove(media: media, resourceIds: &result)
+        if let paidContent = media as? TelegramMediaPaidContent {
+            for extendedMedia in paidContent.extendedMedia {
+                if case let .full(nestedMedia) = extendedMedia {
+                    append(nestedMedia)
+                }
+            }
+        } else if let webpage = media as? TelegramMediaWebpage, case let .Loaded(content) = webpage.content {
+            if let image = content.image {
+                append(image)
+            }
+            if let file = content.file {
+                append(file)
+            }
+            if let instantPage = content.instantPage?._parse() {
+                for nestedMedia in instantPage.rawMedia.values {
+                    append(nestedMedia)
+                }
+            }
+        }
+    }
+
+    for media in message.effectiveMedia {
+        append(media)
+    }
+    return result
+}
+
+// Count existing cached archive attachments once. Durable Ayu resources are
+// accounted by the journal even when their MediaBox cache has been cleared.
+// The caller must fail closed if an otherwise-present cached file cannot be
+// measured; undercounting would allow new copies beyond the user's limit.
+private func ayuCachedArchiveUsage(transaction: Transaction, mediaBox: MediaBox) -> (total: Int64, disappearing: Int64)? {
+    let index: DeletedMessageArchiveIndex
+    if let stored = transaction.getPreferencesEntry(key: PreferencesKeys.deletedMessageArchiveIndex) {
+        guard let decoded = stored.get(DeletedMessageArchiveIndex.self) else { return nil }
+        index = decoded
+    } else {
+        index = .empty
+    }
+    var resources: [MediaResourceId: Bool] = [:]
+    for entry in index.messageIds {
+        guard let message = transaction.getMessage(entry.messageId) else { return nil }
+        let disappearing = messageIsDisappearing(message)
+        for resourceId in archivedResourceIds(message) {
+            if resourceId.stringRepresentation.hasPrefix("ayu-archive-file-") { continue }
+            resources[resourceId] = (resources[resourceId] ?? false) || disappearing
+        }
+    }
+    var total: Int64 = 0
+    var disappearing: Int64 = 0
+    for (resourceId, isDisappearing) in resources {
+        guard let path = mediaBox.completedResourcePath(id: resourceId) else { continue }
+        guard let size = fileSize(path), size >= 0 else { return nil }
+        let (nextTotal, totalOverflow) = total.addingReportingOverflow(size)
+        guard !totalOverflow else { return nil }
+        total = nextTotal
+        if isDisappearing {
+            let (nextDisappearing, disappearingOverflow) = disappearing.addingReportingOverflow(size)
+            guard !disappearingOverflow else { return nil }
+            disappearing = nextDisappearing
+        }
+    }
+    return (total, disappearing)
+}
+
+// Experimental reservation only. No file is copied and no server action is
+// sent here. Callers must wait for this transaction to commit before file I/O.
+func ayuReserveViewOnceCopy(transaction: Transaction, mediaBox: MediaBox, messageId: MessageId, fileId: Int64, token: UUID, expectedBytes: Int64, createdAt: Int64) -> Bool {
+    guard messageId.peerId.namespace == Namespaces.Peer.CloudUser,
+          messageId.namespace == Namespaces.Message.Cloud,
+          ghostModeSettings(transaction: transaction).keepsViewOnceMedia,
+          let settings = prepareDeletedMessageArchive(transaction: transaction, mediaBox: mediaBox),
+          let message = transaction.getMessage(messageId), message.flags.contains(.Incoming),
+          !isArchiveIneligible(message), !message.isCopyProtected(), message.paidContent == nil,
+          !message.attributes.contains(where: { ($0 as? ConsumableContentMessageAttribute)?.consumed == true }),
+          message.minAutoremoveOrClearTimeout == viewOnceTimeout,
+          message.media.count == 1, let media = message.media.first,
+          expectedBytes > 0 else { return false }
+
+    let resourceId: MediaResourceId
+    if let image = media as? TelegramMediaImage, let largest = largestImageRepresentation(image.representations) {
+        resourceId = largest.resource.id
+    } else if let file = media as? TelegramMediaFile {
+        resourceId = file.resource.id
+    } else {
+        return false
+    }
+    guard let sourcePath = mediaBox.completedResourcePath(id: resourceId),
+          fileSize(sourcePath) == expectedBytes,
+          !FileManager.default.fileExists(atPath: AyuArchiveFileStore.fileURL(mediaBoxBasePath: mediaBox.basePath, fileId: fileId).path),
+          let cached = ayuCachedArchiveUsage(transaction: transaction, mediaBox: mediaBox) else { return false }
+    guard let limit = ayuArchiveJournalBudget(totalLimit: settings.mediaLimitBytes,
+                                              disappearingLimit: settings.disappearingMediaLimitBytes,
+                                              cachedTotal: cached.total, cachedDisappearing: cached.disappearing) else { return false }
+    let identity = AyuArchiveJournal.MessageIdentity(peerId: messageId.peerId.toInt64(), namespace: messageId.namespace, id: messageId.id)
+    return updateAyuArchiveJournal(transaction: transaction) { journal in
+        return journal.reserve(fileId: fileId, token: token, message: identity, bytes: expectedBytes, createdAt: createdAt, limitBytes: limit)
+    }
+}
+
+private func messageIsDisappearing(_ message: Message) -> Bool {
+    if message.archivedMessageAttribute?.wasDisappearing == true { return true }
+    for attribute in message.attributes {
+        if attribute is AutoremoveTimeoutMessageAttribute
+            || attribute is AutoclearTimeoutMessageAttribute
+            || attribute is ConsumableContentMessageAttribute
+            || attribute is EphemeralMessageAttribute
+            || attribute is EphemeralOutgoingMessageAttribute {
+            return true
+        }
+    }
+    return false
+}
+
+public func deletedMessageArchiveRetentionPlan<ID: Hashable>(
+    items: [(id: ID, size: Int64, isDisappearing: Bool)],
+    limitBytes: Int64,
+    disappearingLimitBytes: Int64
+) -> (retained: [ID], removed: [ID]) {
+    var removed = Set<ID>()
+
+    func trim(candidates: [Int], budget: Int64) {
+        let remaining = candidates.filter { !removed.contains(items[$0].id) }
+        var total: Int64 = remaining.reduce(0) { $0 + items[$1].size }
+        guard total > budget else {
+            return
+        }
+        let ordered = remaining // Items are ordered oldest first.
+        for index in ordered {
+            if total <= budget {
+                break
+            }
+            total -= items[index].size
+            removed.insert(items[index].id)
+        }
+    }
+
+    trim(candidates: items.indices.filter { items[$0].isDisappearing }, budget: disappearingLimitBytes)
+    trim(candidates: Array(items.indices), budget: limitBytes)
+
+    var retained: [ID] = []
+    var removedIds: [ID] = []
+    for item in items {
+        if removed.contains(item.id) {
+            removedIds.append(item.id)
+        } else {
+            retained.append(item.id)
+        }
+    }
+    return (retained: retained, removed: removedIds)
+}
+
+@discardableResult
+private func updateDeletedMessageArchiveMediaRetention(transaction: Transaction, mediaBox: MediaBox, protectedIds: Set<MediaResourceId> = []) -> Bool {
+    guard ayuCanDiscardArchiveCopies(transaction: transaction) else { return false }
+    let settings = deletedMessageArchiveSettings(transaction: transaction)
+    let index = transaction.getPreferencesEntry(key: PreferencesKeys.deletedMessageArchiveIndex)?.get(DeletedMessageArchiveIndex.self) ?? .empty
+
+    var orderedResourceIds: [MediaResourceId] = []
+    var disappearingResourceIds = Set<MediaResourceId>()
+    var seenResourceIds = Set<MediaResourceId>()
+    for entry in index.messageIds.reversed() {
+        guard let message = transaction.getMessage(entry.messageId) else {
+            continue
+        }
+        let isDisappearing = messageIsDisappearing(message)
+        for id in archivedResourceIds(message).reversed() {
+            if isDisappearing {
+                disappearingResourceIds.insert(id)
+            }
+            if seenResourceIds.insert(id).inserted {
+                orderedResourceIds.append(id)
+            }
+        }
+    }
+    orderedResourceIds.reverse()
+
+    var completedResources: [(id: MediaResourceId, size: Int64, isDisappearing: Bool)] = []
+    for id in orderedResourceIds {
+        if let path = mediaBox.completedResourcePath(id: id), let size = fileSize(path) {
+            completedResources.append((id: id, size: size, isDisappearing: disappearingResourceIds.contains(id)))
+        }
+    }
+
+    guard let journal = ayuArchiveJournal(transaction: transaction),
+          let journalBytes = journal.accountedBytes,
+          let budgets = ayuArchiveCacheBudgets(totalLimit: settings.mediaLimitBytes,
+                                               disappearingLimit: settings.disappearingMediaLimitBytes,
+                                               journalBytes: journalBytes) else { return false }
+    let plan = deletedMessageArchiveRetentionPlan(
+        items: completedResources,
+        limitBytes: budgets.total,
+        disappearingLimitBytes: budgets.disappearing
+    )
+    let idsToRemove = plan.removed
+    let retainedIds = plan.retained
+    guard protectedIds.isDisjoint(with: Set(idsToRemove)) else { return false }
+
+    if !idsToRemove.isEmpty {
+        let _ = mediaBox.removeCachedResources(idsToRemove, force: true).start()
+    }
+    var updatedKeepDisposables: [DeletedMessageArchiveKeptResourceKey: Disposable] = [:]
+    for id in retainedIds {
+        updatedKeepDisposables[DeletedMessageArchiveKeptResourceKey(mediaBoxPath: mediaBox.basePath, resourceId: id)] = mediaBox.keepResource(id: id).start()
+    }
+    var removedKeepDisposables: [Disposable] = []
+    let _ = deletedMessageArchiveMediaKeepDisposables.modify { current in
+        var current = current
+        let removedKeys = current.keys.filter { $0.mediaBoxPath == mediaBox.basePath }
+        for key in removedKeys {
+            if let disposable = current.removeValue(forKey: key) {
+                removedKeepDisposables.append(disposable)
+            }
+        }
+        for (key, disposable) in updatedKeepDisposables {
+            current[key] = disposable
+        }
+        return current
+    }
+    for disposable in removedKeepDisposables {
+        disposable.dispose()
+    }
+    return true
+}
+
+private func archiveAttribute(_ attributes: [MessageAttribute]) -> ArchivedMessageAttribute? {
+    return attributes.first(where: { $0 is ArchivedMessageAttribute }) as? ArchivedMessageAttribute
+}
+
+private func attributesWithoutArchiveMetadata(_ attributes: [MessageAttribute]) -> [MessageAttribute] {
+    return attributes.filter {
+        !($0 is ArchivedMessageAttribute) && !($0 is ArchivedMessageVersionAttribute)
+    }
+}
+
+private func isVolatileEditedMessageAttribute(_ attribute: MessageAttribute) -> Bool {
+    return attribute is ArchivedMessageAttribute
+        || attribute is ArchivedMessageVersionAttribute
+        || attribute is EditedMessageAttribute
+        || attribute is ReactionsMessageAttribute
+        || attribute is PendingReactionsMessageAttribute
+        || attribute is PendingStarsReactionsMessageAttribute
+        || attribute is ViewCountMessageAttribute
+        || attribute is ForwardCountMessageAttribute
+        || attribute is NotificationInfoMessageAttribute
+        || attribute is ChannelMessageStateVersionAttribute
+        || attribute is PeerGroupMessageStateVersionAttribute
+        || attribute is TranslationMessageAttribute
+}
+
+private func encodedContentAttributes(_ attributes: [MessageAttribute]) -> [Data] {
+    return attributes.compactMap { attribute -> Data? in
+        if isVolatileEditedMessageAttribute(attribute) {
+            return nil
+        }
+        let encoder = PostboxEncoder()
+        encoder.encodeRootObject(attribute)
+        var data = Data(String(describing: type(of: attribute)).utf8)
+        data.append(encoder.makeData())
+        return data
+    }
+}
+
+private func mediaArraysAreEqual(_ lhs: [Media], _ rhs: [Media]) -> Bool {
+    if lhs.count != rhs.count {
+        return false
+    }
+    for i in 0 ..< lhs.count {
+        if !lhs[i].isEqual(to: rhs[i]) {
+            return false
+        }
+    }
+    return true
+}
+
+public func deletedMessageArchiveContentsAreEqual(
+    lhsText: String,
+    lhsAttributes: [MessageAttribute],
+    lhsMedia: [Media],
+    rhsText: String,
+    rhsAttributes: [MessageAttribute],
+    rhsMedia: [Media]
+) -> Bool {
+    if lhsText != rhsText {
+        return false
+    }
+    if !mediaArraysAreEqual(lhsMedia, rhsMedia) {
+        return false
+    }
+    return encodedContentAttributes(lhsAttributes) == encodedContentAttributes(rhsAttributes)
+}
+
+private func archivedContentIsEqual(_ previous: Message, _ updated: StoreMessage) -> Bool {
+    return deletedMessageArchiveContentsAreEqual(
+        lhsText: previous.text,
+        lhsAttributes: previous.attributes,
+        lhsMedia: previous.media,
+        rhsText: updated.text,
+        rhsAttributes: updated.attributes,
+        rhsMedia: updated.media
+    )
+}
+
+private func shouldSkipBotDialog(transaction: Transaction, message: Message, settings: DeletedMessageArchiveSettings) -> Bool {
+    guard !settings.saveBotDialogs else { return false }
+    return (transaction.getPeer(message.id.peerId) as? TelegramUser)?.botInfo != nil
+}
+
+private func isArchiveIneligible(_ message: Message) -> Bool {
+    if message.id.peerId.namespace == Namespaces.Peer.SecretChat {
+        return true
+    }
+    if message.id.namespace != Namespaces.Message.Cloud {
+        return true
+    }
+    return message.media.contains(where: { $0 is TelegramMediaExpiredContent })
+}
+
+private func attributesWithoutExpiry(_ attributes: [MessageAttribute]) -> [MessageAttribute] {
+    return attributes.filter { attribute in
+        if attribute is AutoremoveTimeoutMessageAttribute
+            || attribute is AutoclearTimeoutMessageAttribute
+            || attribute is ConsumableContentMessageAttribute
+            || attribute is ConsumablePersonalMentionMessageAttribute {
+            return false
+        }
+        return true
+    }
+}
+
+private func makeStoredCopy(
+    of message: Message,
+    namespace: MessageId.Namespace,
+    attributes: [MessageAttribute],
+    globallyUniqueId: Int64,
+    keepGlobalTags: Bool,
+    mediaOverride: [Media]? = nil
+) -> StoreMessage {
+    let attributes = attributesWithoutExpiry(attributes)
+    var flags = StoreMessageFlags(message.flags)
+    flags.remove(.Unsent)
+    flags.remove(.Failed)
+    flags.remove(.Sending)
+    flags.remove(.CountedAsIncoming)
+
+    var tags = message.tags
+    tags.remove(.unseenPersonalMessage)
+    tags.remove(.unseenReaction)
+    tags.remove(.unseenPollVote)
+    tags.remove(.pinned)
+
+    return StoreMessage(
+        peerId: message.id.peerId,
+        namespace: namespace,
+        customStableId: nil,
+        globallyUniqueId: globallyUniqueId,
+        groupingKey: message.groupingKey,
+        threadId: message.threadId,
+        timestamp: message.timestamp,
+        flags: flags,
+        tags: tags,
+        globalTags: keepGlobalTags ? message.globalTags : [],
+        localTags: [],
+        forwardInfo: message.forwardInfo.flatMap(StoreMessageForwardInfo.init),
+        authorId: message.author?.id,
+        text: message.text,
+        attributes: attributes,
+        media: mediaOverride ?? message.media
+    )
+}
+
+// Prepare, but do not commit, an independent pending snapshot.
+// A transaction rechecks identity after the potentially long file copy; it
+// does not make the filesystem and Postbox commit atomic.
+func ayuPreparedViewOnceStoreMessage(transaction: Transaction, mediaBox: MediaBox, id: MessageId, candidate: AyuArchiveSnapshotCandidate) -> StoreMessage? {
+    guard id.peerId.namespace == Namespaces.Peer.CloudUser,
+          id.namespace == Namespaces.Message.Cloud,
+          let message = transaction.getMessage(id), message.flags.contains(.Incoming),
+          !isArchiveIneligible(message), !message.isCopyProtected(), message.paidContent == nil,
+          !message.attributes.contains(where: { ($0 as? ConsumableContentMessageAttribute)?.consumed == true }),
+          message.media.count == 1, let currentMedia = message.media.first,
+          currentMedia.isEqual(to: candidate.sourceMedia) else { return nil }
+    let isViewOnce = message.attributes.contains { attribute in
+        if let attribute = attribute as? AutoremoveTimeoutMessageAttribute { return attribute.timeout == viewOnceTimeout }
+        if let attribute = attribute as? AutoclearTimeoutMessageAttribute { return attribute.timeout == viewOnceTimeout }
+        return false
+    }
+    guard isViewOnce else { return nil }
+    let sourceId: MediaResourceId
+    if let image = currentMedia as? TelegramMediaImage, let largest = largestImageRepresentation(image.representations) {
+        sourceId = largest.resource.id
+    } else if let file = currentMedia as? TelegramMediaFile {
+        sourceId = file.resource.id
+    } else {
+        return nil
+    }
+    guard sourceId == candidate.sourceResourceId,
+          let expectedModel = ayuArchivedMediaCopy(currentMedia, fileId: candidate.archiveFileId, size: candidate.byteCount, sha256: candidate.sha256),
+          expectedModel.isEqual(to: candidate.archivedMedia) else { return nil }
+    let settings = deletedMessageArchiveSettings(transaction: transaction)
+    guard candidate.byteCount > 0,
+          candidate.byteCount <= settings.mediaLimitBytes,
+          candidate.byteCount <= settings.disappearingMediaLimitBytes,
+          let sourcePath = mediaBox.completedResourcePath(id: sourceId) else { return nil }
+    let archivePath = AyuArchiveFileStore.fileURL(mediaBoxBasePath: mediaBox.basePath, fileId: candidate.archiveFileId).path
+    guard let sourceAttributes = try? FileManager.default.attributesOfItem(atPath: sourcePath),
+          let archiveAttributes = try? FileManager.default.attributesOfItem(atPath: archivePath),
+          sourceAttributes[.type] as? FileAttributeType == .typeRegular,
+          archiveAttributes[.type] as? FileAttributeType == .typeRegular,
+          (sourceAttributes[.size] as? NSNumber)?.int64Value == candidate.byteCount,
+          (archiveAttributes[.size] as? NSNumber)?.int64Value == candidate.byteCount else { return nil }
+    let previous = archiveAttribute(message.attributes)
+    var attributes = attributesWithoutArchiveMetadata(message.attributes)
+    attributes.append(ArchivedMessageAttribute(originalMessageId: previous?.originalMessageId ?? id, versionIds: previous?.versionIds ?? [], deletedAt: archiveTimestamp(), sessionId: previous?.sessionId ?? deletedMessageArchiveSessionId, wasDisappearing: true, pendingBurn: true))
+    return makeStoredCopy(of: message, namespace: Namespaces.Message.Archived, attributes: attributes, globallyUniqueId: Int64.random(in: Int64.min ... Int64.max), keepGlobalTags: false, mediaOverride: [candidate.archivedMedia])
+}
+
+// Experimental transaction stage: inserts a pending independent snapshot and
+// its journal entry together. This transaction never contacts Telegram.
+// The verified file can still change after hashing; recovery/GC and device
+// playback and recovery must be tested on a real device before release.
+func ayuCommitPreparedViewOnceCopy(transaction: Transaction, mediaBox: MediaBox, messageId: MessageId, token: UUID, verified: AyuVerifiedArchiveSnapshot) -> MessageId? {
+    let candidate = verified.candidate
+    let identity = AyuArchiveJournal.MessageIdentity(peerId: messageId.peerId.toInt64(), namespace: messageId.namespace, id: messageId.id)
+    guard candidate.reservationToken == token,
+          ghostModeSettings(transaction: transaction).keepsViewOnceMedia,
+          var journal = ayuArchiveJournal(transaction: transaction),
+          let reservation = journal.entries.first(where: { $0.fileId == candidate.archiveFileId && $0.token == token }),
+          reservation.state == .reserved, reservation.message == identity,
+          reservation.bytes == candidate.byteCount,
+          let cached = ayuCachedArchiveUsage(transaction: transaction, mediaBox: mediaBox) else { return nil }
+
+    let settings = deletedMessageArchiveSettings(transaction: transaction)
+    guard let budget = ayuArchiveJournalBudget(totalLimit: settings.mediaLimitBytes,
+                                               disappearingLimit: settings.disappearingMediaLimitBytes,
+                                               cachedTotal: cached.total, cachedDisappearing: cached.disappearing),
+          let accounted = journal.accountedBytes, accounted <= budget,
+          journal.commit(fileId: candidate.archiveFileId, token: token, actualBytes: candidate.byteCount, sha256: candidate.sha256, sourceResourceId: candidate.sourceResourceId.stringRepresentation),
+          let encodedJournal = PreferencesEntry(journal),
+          encodedJournal.get(AyuArchiveJournal.self) == journal,
+          let storedMessage = ayuPreparedViewOnceStoreMessage(transaction: transaction, mediaBox: mediaBox, id: messageId, candidate: candidate),
+          let uniqueId = storedMessage.globallyUniqueId,
+          transaction.messageIdForGloballyUniqueMessageId(peerId: messageId.peerId, id: uniqueId) == nil else { return nil }
+
+    var index: DeletedMessageArchiveIndex
+    if let stored = transaction.getPreferencesEntry(key: PreferencesKeys.deletedMessageArchiveIndex) {
+        guard let decoded = stored.get(DeletedMessageArchiveIndex.self) else { return nil }
+        index = decoded
+    } else {
+        index = .empty
+    }
+    guard let archivedId = transaction.addMessages([storedMessage], location: .Random)[uniqueId] else { return nil }
+    index.messageIds.append(DeletedMessageArchiveIndexEntry(archivedId))
+    guard let encodedIndex = PreferencesEntry(index), encodedIndex.get(DeletedMessageArchiveIndex.self) == index else {
+        transaction.deleteMessages([archivedId], forEachMedia: nil)
+        return nil
+    }
+    transaction.setPreferencesEntry(key: PreferencesKeys.deletedMessageArchiveIndex, value: encodedIndex)
+    transaction.setPreferencesEntry(key: PreferencesKeys.ayuArchiveJournal, value: encodedJournal)
+    return archivedId
+}
+
+// Revalidate the journal, archive index and stored resource together. Missing
+// or duplicated entries fail closed. This does not hash the file or send a
+// network request.
+func ayuPendingBurnReference(transaction: Transaction, originalId: MessageId, state: AyuArchiveJournal.State) -> AyuBurnSnapshotReference? {
+    let identity = AyuArchiveJournal.MessageIdentity(peerId: originalId.peerId.toInt64(), namespace: originalId.namespace, id: originalId.id)
+    guard let journal = ayuArchiveJournal(transaction: transaction),
+          let entry = journal.entries.first(where: { $0.message == identity && $0.state == state }),
+          let digest = entry.sha256, digest.count == 32,
+          let sourceResourceId = entry.sourceResourceId,
+          let indexEntry = transaction.getPreferencesEntry(key: PreferencesKeys.deletedMessageArchiveIndex),
+          let index = indexEntry.get(DeletedMessageArchiveIndex.self) else { return nil }
+    var found: AyuBurnSnapshotReference?
+    for indexedId in index.messageIds {
+        guard let archived = transaction.getMessage(indexedId.messageId) else { return nil }
+        guard archived.id.namespace == Namespaces.Message.Archived,
+              let attribute = archived.archivedMessageAttribute,
+              attribute.originalMessageId == originalId,
+              attribute.wasDisappearing else { continue }
+        let matchesState = state == .burned ? (attribute.wasBurned && !attribute.pendingBurn) : (attribute.pendingBurn && !attribute.wasBurned)
+        guard matchesState else { continue }
+        guard found == nil, archived.media.count == 1, let media = archived.media.first else { return nil }
+        let resource: AyuArchiveMediaResource?
+        if let image = media as? TelegramMediaImage,
+           image.imageId == MediaId(namespace: Namespaces.Media.AyuArchivedImage, id: entry.fileId),
+           image.representations.count == 1 {
+            resource = image.representations.first?.resource as? AyuArchiveMediaResource
+        } else if let file = media as? TelegramMediaFile,
+                  file.fileId == MediaId(namespace: Namespaces.Media.AyuArchivedFile, id: entry.fileId) {
+            resource = file.resource as? AyuArchiveMediaResource
+        } else {
+            return nil
+        }
+        guard let resource, resource.fileId == entry.fileId, resource.size == entry.bytes,
+              resource.sha256 == digest else { return nil }
+        found = AyuBurnSnapshotReference(originalId: originalId, archivedId: archived.id, fileId: entry.fileId,
+                                         token: entry.token, byteCount: entry.bytes, sha256: digest, sourceResourceId: sourceResourceId)
+    }
+    return found
+}
+
+// This transaction only prepares the journal state. The coordinator protects
+// the snapshot from deletion and retains it if the network outcome is unclear.
+func ayuBeginPreparedViewOnceBurn(transaction: Transaction, verified: AyuVerifiedBurnSnapshot) -> Bool {
+    let reference = verified.reference
+    guard reference.originalId.peerId.namespace == Namespaces.Peer.CloudUser,
+          reference.originalId.namespace == Namespaces.Message.Cloud,
+          ghostModeSettings(transaction: transaction).keepsViewOnceMedia,
+          let original = transaction.getMessage(reference.originalId), original.flags.contains(.Incoming),
+          !isArchiveIneligible(original), !original.isCopyProtected(), original.paidContent == nil,
+          original.minAutoremoveOrClearTimeout == viewOnceTimeout,
+          !original.attributes.contains(where: { ($0 as? ConsumableContentMessageAttribute)?.consumed == true }),
+          original.media.count == 1, let media = original.media.first,
+          ayuViewOnceSourceResourceId(media)?.stringRepresentation == reference.sourceResourceId,
+          ayuPendingBurnReference(transaction: transaction, originalId: reference.originalId, state: .committed) == reference,
+          var journal = ayuArchiveJournal(transaction: transaction),
+          journal.beginBurn(fileId: reference.fileId, token: reference.token),
+          let encoded = PreferencesEntry(journal), encoded.get(AyuArchiveJournal.self) == journal else { return false }
+    transaction.setPreferencesEntry(key: PreferencesKeys.ayuArchiveJournal, value: encoded)
+    return true
+}
+
+// Only a confirmed server outcome may call this; both the visible marker and
+// journal state change in the same Postbox transaction. No request is sent.
+func ayuConfirmPreparedViewOnceBurn(transaction: Transaction, reference: AyuBurnSnapshotReference) -> Bool {
+    if ayuPendingBurnReference(transaction: transaction, originalId: reference.originalId, state: .burned) == reference {
+        return true
+    }
+    guard ayuPendingBurnReference(transaction: transaction, originalId: reference.originalId, state: .burnInFlight) == reference,
+          var journal = ayuArchiveJournal(transaction: transaction),
+          journal.confirmBurn(fileId: reference.fileId, token: reference.token),
+          let encoded = PreferencesEntry(journal), encoded.get(AyuArchiveJournal.self) == journal,
+          finalizeBurnSnapshot(transaction: transaction, originalId: reference.originalId) else { return false }
+    transaction.setPreferencesEntry(key: PreferencesKeys.ayuArchiveJournal, value: encoded)
+    return true
+}
+
+// A Telegram read-content update is authoritative evidence of consumption.
+// If it arrives before the request completes, finalize the same journal entry
+// and snapshot together. A merely prepared copy must not be marked burned.
+func ayuReconcilePendingBurnFromRemoteUpdate(transaction: Transaction, originalId: MessageId) -> Bool {
+    if let reference = ayuPendingBurnReference(transaction: transaction, originalId: originalId, state: .burnInFlight) {
+        return ayuConfirmPreparedViewOnceBurn(transaction: transaction, reference: reference)
+    }
+    return ayuPendingBurnReference(transaction: transaction, originalId: originalId, state: .burned) != nil
+}
+
+private func addStoredCopy(
+    transaction: Transaction,
+    message: Message,
+    namespace: MessageId.Namespace,
+    attributes: [MessageAttribute],
+    keepGlobalTags: Bool = false
+) -> MessageId? {
+    let globallyUniqueId = Int64.random(in: Int64.min ... Int64.max)
+    let copy = makeStoredCopy(
+        of: message,
+        namespace: namespace,
+        attributes: attributes,
+        globallyUniqueId: globallyUniqueId,
+        keepGlobalTags: keepGlobalTags
+    )
+    return transaction.addMessages([copy], location: .Random)[globallyUniqueId]
+}
+
+func archivePreviousMessageVersionIfNeeded(
+    transaction: Transaction,
+    id: MessageId,
+    updatedMessage: StoreMessage,
+    mediaBox: MediaBox? = nil
+) -> StoreMessage {
+    guard let settings = prepareDeletedMessageArchive(transaction: transaction, mediaBox: mediaBox), settings.saveEditedVersions else {
+        return updatedMessage
+    }
+    guard let previous = transaction.getMessage(id), !isArchiveIneligible(previous), !shouldSkipBotDialog(transaction: transaction, message: previous, settings: settings) else {
+        return updatedMessage
+    }
+
+    let previousArchiveAttribute = archiveAttribute(previous.attributes)
+    if archivedContentIsEqual(previous, updatedMessage) {
+        guard let previousArchiveAttribute else {
+            return updatedMessage
+        }
+        var attributes = attributesWithoutArchiveMetadata(updatedMessage.attributes)
+        attributes.append(previousArchiveAttribute)
+        return updatedMessage.withUpdatedAttributes(attributes)
+    }
+
+    let capturedAt = updatedMessage.attributes.compactMap { ($0 as? EditedMessageAttribute)?.date }.first ?? archiveTimestamp()
+    var snapshotAttributes = attributesWithoutArchiveMetadata(previous.attributes)
+    snapshotAttributes.append(ArchivedMessageVersionAttribute(capturedAt: capturedAt))
+    guard let snapshotId = addStoredCopy(
+        transaction: transaction,
+        message: previous,
+        namespace: Namespaces.Message.ArchivedVersion,
+        attributes: snapshotAttributes
+    ) else {
+        return updatedMessage
+    }
+    updateDeletedMessageArchiveIndex(transaction: transaction, { current in
+        var current = current
+        current.messageIds.append(DeletedMessageArchiveIndexEntry(snapshotId))
+        let liveEntry = DeletedMessageArchiveIndexEntry(id)
+        if !current.liveMessageIds.contains(liveEntry) {
+            current.liveMessageIds.append(liveEntry)
+        }
+        return current
+    })
+    if let mediaBox {
+        updateDeletedMessageArchiveMediaRetention(transaction: transaction, mediaBox: mediaBox)
+    }
+
+    var versionIds = previousArchiveAttribute?.versionIds ?? []
+    if versionIds.last != snapshotId {
+        versionIds.append(snapshotId)
+    }
+    let updatedArchiveAttribute = ArchivedMessageAttribute(
+        originalMessageId: previousArchiveAttribute?.originalMessageId ?? previous.id,
+        versionIds: versionIds,
+        deletedAt: nil,
+        sessionId: previousArchiveAttribute?.sessionId ?? deletedMessageArchiveSessionId,
+        wasDisappearing: previousArchiveAttribute?.wasDisappearing ?? messageIsDisappearing(previous)
+    )
+    var attributes = attributesWithoutArchiveMetadata(updatedMessage.attributes)
+    attributes.append(updatedArchiveAttribute)
+    return updatedMessage.withUpdatedAttributes(attributes)
+}
+
+@discardableResult
+func archiveMessagesBeforeCloudDeletion(
+    transaction: Transaction,
+    ids: [MessageId],
+    deletedAt: Int32 = archiveTimestamp(),
+    mediaBox: MediaBox? = nil
+) -> [MessageId] {
+    guard let settings = prepareDeletedMessageArchive(transaction: transaction, mediaBox: mediaBox) else {
+        return []
+    }
+    if !settings.saveDeletedMessages {
+        guard ayuCanDiscardArchiveCopies(transaction: transaction) else { return [] }
+        if let mediaBox {
+            removeDeletedMessageArchiveForLocalDeletion(transaction: transaction, mediaBox: mediaBox, ids: ids)
+        } else {
+            var versionIds: [MessageId] = []
+            var liveEntries = Set<DeletedMessageArchiveIndexEntry>()
+            for id in ids {
+                if let attribute = transaction.getMessage(id)?.archivedMessageAttribute {
+                    versionIds.append(contentsOf: attribute.versionIds)
+                    liveEntries.insert(DeletedMessageArchiveIndexEntry(id))
+                }
+            }
+            if !versionIds.isEmpty {
+                transaction.deleteMessages(versionIds, forEachMedia: nil)
+                let versionEntries = Set(versionIds.map(DeletedMessageArchiveIndexEntry.init))
+                updateDeletedMessageArchiveIndex(transaction: transaction, { current in
+                    var current = current
+                    current.messageIds.removeAll(where: { versionEntries.contains($0) })
+                    current.liveMessageIds.removeAll(where: { liveEntries.contains($0) })
+                    return current
+                })
+            }
+        }
+        return []
+    }
+    var result: [MessageId] = []
+    for id in ids {
+        guard let message = transaction.getMessage(id), !isArchiveIneligible(message), !shouldSkipBotDialog(transaction: transaction, message: message, settings: settings) else {
+            continue
+        }
+        let previousArchiveAttribute = archiveAttribute(message.attributes)
+        var attributes = attributesWithoutArchiveMetadata(message.attributes)
+        attributes.append(ArchivedMessageAttribute(
+            originalMessageId: previousArchiveAttribute?.originalMessageId ?? message.id,
+            versionIds: previousArchiveAttribute?.versionIds ?? [],
+            deletedAt: deletedAt,
+            sessionId: previousArchiveAttribute?.sessionId ?? deletedMessageArchiveSessionId,
+            wasDisappearing: previousArchiveAttribute?.wasDisappearing ?? messageIsDisappearing(message)
+        ))
+        if let archivedId = addStoredCopy(
+            transaction: transaction,
+            message: message,
+            namespace: Namespaces.Message.Archived,
+            attributes: attributes
+        ) {
+            result.append(archivedId)
+        }
+    }
+    if !result.isEmpty {
+        updateDeletedMessageArchiveIndex(transaction: transaction, { current in
+            var current = current
+            current.messageIds.append(contentsOf: result.map(DeletedMessageArchiveIndexEntry.init))
+            let deletedEntries = Set(ids.map(DeletedMessageArchiveIndexEntry.init))
+            current.liveMessageIds.removeAll(where: { deletedEntries.contains($0) })
+            return current
+        })
+        if let mediaBox {
+            updateDeletedMessageArchiveMediaRetention(transaction: transaction, mediaBox: mediaBox)
+        }
+    }
+    return result
+}
+
+func finalizeBurnSnapshot(transaction: Transaction, originalId: MessageId) -> Bool {
+    let index = transaction.getPreferencesEntry(key: PreferencesKeys.deletedMessageArchiveIndex)?.get(DeletedMessageArchiveIndex.self) ?? .empty
+    var alreadyFinalized = false
+    for entry in index.messageIds {
+        guard let message = transaction.getMessage(entry.messageId), let attribute = message.archivedMessageAttribute,
+              message.id.namespace == Namespaces.Message.Archived, attribute.originalMessageId == originalId,
+              attribute.wasDisappearing else { continue }
+        if !attribute.pendingBurn {
+            alreadyFinalized = alreadyFinalized || attribute.wasBurned
+            continue
+        }
+        guard !attribute.wasBurned else { return false }
+        transaction.updateMessage(message.id, update: { current in
+            var attributes = current.attributes.filter { !($0 is ArchivedMessageAttribute) }
+            attributes.append(ArchivedMessageAttribute(originalMessageId: attribute.originalMessageId, versionIds: attribute.versionIds, deletedAt: attribute.deletedAt, sessionId: attribute.sessionId, wasDisappearing: attribute.wasDisappearing, pendingBurn: false, wasBurned: true))
+            return .update(StoreMessage(id: current.id, customStableId: nil, globallyUniqueId: current.globallyUniqueId, groupingKey: current.groupingKey, threadId: current.threadId, timestamp: current.timestamp, flags: StoreMessageFlags(current.flags), tags: current.tags, globalTags: current.globalTags, localTags: current.localTags, forwardInfo: current.forwardInfo.flatMap(StoreMessageForwardInfo.init), authorId: current.author?.id, text: current.text, attributes: attributes, media: current.media))
+        })
+        return true
+    }
+    return alreadyFinalized
+}
+
+// Mark only files whose indexed references are all part of this explicit
+// deletion. Persist the marks in the same transaction as the archive change;
+// the caller unlinks only after the transaction commits. Inconsistent indexes
+// or resources fail closed rather than risking somebody else's saved media.
+func ayuMarkExplicitArchiveDeletions(transaction: Transaction, selectedIds: Set<MessageId>?, requireAllJournalEntries: Bool = false) -> [AyuArchiveJournal.Deletion]? {
+    guard var journal = ayuArchiveJournal(transaction: transaction) else { return nil }
+    let index: DeletedMessageArchiveIndex
+    if let stored = transaction.getPreferencesEntry(key: PreferencesKeys.deletedMessageArchiveIndex) {
+        guard let decoded = stored.get(DeletedMessageArchiveIndex.self) else { return nil }
+        index = decoded
+    } else {
+        index = .empty
+    }
+    let allIds = Set((index.messageIds + index.liveMessageIds).map(\.messageId))
+    let selected = selectedIds ?? allIds
+    guard selected.isSubset(of: allIds) else { return nil }
+    var indexed: [AyuArchiveIndexedFile<MessageId>] = []
+    for id in allIds {
+        guard let message = transaction.getMessage(id) else { return nil }
+        for media in message.media {
+            var resources: [AyuArchiveMediaResource] = []
+            if let image = media as? TelegramMediaImage {
+                resources = image.representations.compactMap { $0.resource as? AyuArchiveMediaResource }
+            } else if let file = media as? TelegramMediaFile {
+                resources = ([file.resource] + file.previewRepresentations.map(\.resource)).compactMap { $0 as? AyuArchiveMediaResource }
+            }
+            guard !resources.isEmpty else { continue }
+            guard let original = message.archivedMessageAttribute?.originalMessageId else { return nil }
+            let identity = AyuArchiveJournal.MessageIdentity(peerId: original.peerId.toInt64(), namespace: original.namespace, id: original.id)
+            for resource in resources {
+                guard let size = resource.size else { return nil }
+                indexed.append(AyuArchiveIndexedFile(key: id, original: identity, fileId: resource.fileId, byteCount: size, sha256: resource.sha256))
+            }
+        }
+    }
+    guard let fileIds = ayuArchiveFileIdsForExplicitDeletion(journal: journal, indexed: indexed, selected: selected) else { return nil }
+    // Session-wide removal must be all-or-nothing. Otherwise an unindexed
+    // committed copy would prevent the index from being cleared after other
+    // files had already been marked and scheduled for deletion.
+    if requireAllJournalEntries && !journal.entries.allSatisfy({ $0.state == .deleting || fileIds.contains($0.fileId) }) {
+        return nil
+    }
+    guard
+          let deletions = journal.markExplicitDeletions(fileIds: fileIds),
+          let encoded = PreferencesEntry(journal), encoded.get(AyuArchiveJournal.self) == journal else { return nil }
+    transaction.setPreferencesEntry(key: PreferencesKeys.ayuArchiveJournal, value: encoded)
+    return deletions
+}
+
+func _internal_deleteArchivedMessage(transaction: Transaction, mediaBox: MediaBox, id: MessageId) {
+    guard ayuCanDiscardArchiveCopies(transaction: transaction),
+          id.namespace == Namespaces.Message.Archived, let message = transaction.getMessage(id) else {
+        return
+    }
+    let versionIds = message.archivedMessageAttribute?.versionIds ?? []
+    transaction.deleteMessages(versionIds + [id], forEachMedia: nil)
+    let removedIds = Set((versionIds + [id]).map(DeletedMessageArchiveIndexEntry.init))
+    updateDeletedMessageArchiveIndex(transaction: transaction, { current in
+        var current = current
+        current.messageIds.removeAll(where: { removedIds.contains($0) })
+        return current
+    })
+    updateDeletedMessageArchiveMediaRetention(transaction: transaction, mediaBox: mediaBox)
+}
+
+func removeDeletedMessageArchiveForLocalDeletion(transaction: Transaction, mediaBox: MediaBox, ids: [MessageId]) {
+    guard ayuCanDiscardArchiveCopies(transaction: transaction) else { return }
+    var versionIds: [MessageId] = []
+    var archivedSourceIds: [MessageId] = []
+    var resourceIds = Set<MediaResourceId>()
+    for id in ids {
+        guard let message = transaction.getMessage(id), let attribute = message.archivedMessageAttribute else {
+            continue
+        }
+        archivedSourceIds.append(id)
+        versionIds.append(contentsOf: attribute.versionIds)
+        resourceIds.formUnion(archivedResourceIds(message))
+        for versionId in attribute.versionIds {
+            if let version = transaction.getMessage(versionId) {
+                resourceIds.formUnion(archivedResourceIds(version))
+            }
+        }
+    }
+    guard !archivedSourceIds.isEmpty else {
+        return
+    }
+    if !versionIds.isEmpty {
+        transaction.deleteMessages(versionIds, forEachMedia: nil)
+    }
+    if !resourceIds.isEmpty {
+        let _ = mediaBox.removeCachedResources(Array(resourceIds), force: true).start()
+    }
+    let removedStoredEntries = Set(versionIds.map(DeletedMessageArchiveIndexEntry.init))
+    let removedLiveEntries = Set(archivedSourceIds.map(DeletedMessageArchiveIndexEntry.init))
+    updateDeletedMessageArchiveIndex(transaction: transaction, { current in
+        var current = current
+        current.messageIds.removeAll(where: { removedStoredEntries.contains($0) })
+        current.liveMessageIds.removeAll(where: { removedLiveEntries.contains($0) })
+        return current
+    })
+    updateDeletedMessageArchiveMediaRetention(transaction: transaction, mediaBox: mediaBox)
+}
+
+func _internal_archivedMessageVersions(transaction: Transaction, id: MessageId) -> [Message] {
+    guard let message = transaction.getMessage(id), let attribute = message.archivedMessageAttribute else {
+        return []
+    }
+    var result = attribute.versionIds.compactMap(transaction.getMessage)
+    result.append(message)
+    return result
+}
+
+func _internal_deletedMessagesForPeer(transaction: Transaction, peerId: PeerId) -> [Message] {
+    guard let index = transaction.getPreferencesEntry(key: PreferencesKeys.deletedMessageArchiveIndex)?.get(DeletedMessageArchiveIndex.self) else {
+        return []
+    }
+    return index.messageIds.compactMap { entry -> Message? in
+        let id = entry.messageId
+        guard id.peerId == peerId, id.namespace == Namespaces.Message.Archived,
+              let message = transaction.getMessage(id),
+              let attribute = message.archivedMessageAttribute,
+              attribute.deletedAt != nil, !attribute.pendingBurn else {
+            return nil
+        }
+        return message
+    }.sorted { $0.timestamp > $1.timestamp }
+}
+
+func _internal_clearDeletedMessageArchive(transaction: Transaction) {
+    guard ayuCanDiscardArchiveCopies(transaction: transaction) else { return }
+    let index = transaction.getPreferencesEntry(key: PreferencesKeys.deletedMessageArchiveIndex)?.get(DeletedMessageArchiveIndex.self) ?? .empty
+    transaction.deleteMessages(index.messageIds.map(\.messageId), forEachMedia: nil)
+    removeDeletedMessageArchiveMetadata(transaction: transaction, ids: index.liveMessageIds.map(\.messageId))
+    updateDeletedMessageArchiveIndex(transaction: transaction, { _ in .empty })
+}
+
+func _internal_clearDeletedMessageArchiveMedia(transaction: Transaction, mediaBox: MediaBox) {
+    guard ayuCanDiscardArchiveCopies(transaction: transaction) else { return }
+    let index = transaction.getPreferencesEntry(key: PreferencesKeys.deletedMessageArchiveIndex)?.get(DeletedMessageArchiveIndex.self) ?? .empty
+    var resourceIds = Set<MediaResourceId>()
+    for entry in index.messageIds {
+        if let message = transaction.getMessage(entry.messageId) {
+            resourceIds.formUnion(archivedResourceIds(message))
+        }
+    }
+    var removedKeepDisposables: [Disposable] = []
+    let _ = deletedMessageArchiveMediaKeepDisposables.modify { current in
+        var current = current
+        let removedKeys = current.keys.filter { $0.mediaBoxPath == mediaBox.basePath }
+        for key in removedKeys {
+            if let disposable = current.removeValue(forKey: key) {
+                removedKeepDisposables.append(disposable)
+            }
+        }
+        return current
+    }
+    for disposable in removedKeepDisposables {
+        disposable.dispose()
+    }
+    if !resourceIds.isEmpty {
+        let _ = mediaBox.removeCachedResources(Array(resourceIds), force: true).start()
+    }
+}
+
+public struct DeletedMessageArchiveStats: Equatable {
+    public let messageCount: Int
+    public let versionCount: Int
+    public let mediaSize: Int64
+}
+
+func _internal_deletedMessageArchiveStats(transaction: Transaction, mediaBox: MediaBox) -> DeletedMessageArchiveStats {
+    let index = transaction.getPreferencesEntry(key: PreferencesKeys.deletedMessageArchiveIndex)?.get(DeletedMessageArchiveIndex.self) ?? .empty
+    var messageCount = 0
+    var versionCount = 0
+    var resourceIds = Set<MediaResourceId>()
+    for entry in index.messageIds {
+        guard let message = transaction.getMessage(entry.messageId) else {
+            continue
+        }
+        if message.id.namespace == Namespaces.Message.Archived {
+            messageCount += 1
+        } else if message.id.namespace == Namespaces.Message.ArchivedVersion {
+            versionCount += 1
+        }
+        resourceIds.formUnion(archivedResourceIds(message))
+    }
+    var mediaSize: Int64 = 0
+    for id in resourceIds {
+        if let path = mediaBox.completedResourcePath(id: id) {
+            mediaSize += fileSize(path) ?? 0
+        }
+    }
+    return DeletedMessageArchiveStats(messageCount: messageCount, versionCount: versionCount, mediaSize: mediaSize)
+}
+
+func _internal_refreshDeletedMessageArchiveMediaLimit(transaction: Transaction, mediaBox: MediaBox) {
+    updateDeletedMessageArchiveMediaRetention(transaction: transaction, mediaBox: mediaBox)
+}
+
+func initializeDeletedMessageArchiveSession(postbox: Postbox) -> Signal<Never, NoError> {
+    let _ = deletedMessageArchiveSessionInitialized.swap(true)
+    return ayuResumeArchiveFileDeletions(postbox: postbox)
+    |> then(
+        postbox.transaction { transaction -> [AyuArchiveJournal.Deletion] in
+            let settings = deletedMessageArchiveSettings(transaction: transaction)
+            var deletions: [AyuArchiveJournal.Deletion] = []
+            if settings.sessionId != deletedMessageArchiveSessionId && settings.sessionId != 0 && !settings.keepAcrossLaunches {
+                guard let marked = ayuMarkExplicitArchiveDeletions(transaction: transaction, selectedIds: nil, requireAllJournalEntries: true) else { return [] }
+                deletions = marked
+            }
+            _ = prepareDeletedMessageArchive(transaction: transaction, mediaBox: postbox.mediaBox)
+            updateDeletedMessageArchiveMediaRetention(transaction: transaction, mediaBox: postbox.mediaBox)
+            return deletions
+        }
+        |> mapToSignal { deletions -> Signal<Never, NoError> in
+            return ayuFinishArchiveFileDeletions(postbox: postbox, requested: deletions)
+            |> ignoreValues
+        }
+    )
+}
diff --git a/submodules/TelegramCore/Sources/TelegramEngine/Messages/GhostMode.swift b/submodules/TelegramCore/Sources/TelegramEngine/Messages/GhostMode.swift
