+import Foundation
+import Display
+import SwiftSignalKit
+import TelegramCore
+import TelegramPresentationData
+import ItemListUI
+import AccountContext
+
+private final class AyuSettingsArguments {
+    let update: (AyuActivityPrivacySettings.Option, Bool) -> Void
+    let openGhost: () -> Void
+    let openArchive: () -> Void
+    let updateViewOnce: (Bool) -> Void
+
+    init(update: @escaping (AyuActivityPrivacySettings.Option, Bool) -> Void, openGhost: @escaping () -> Void, openArchive: @escaping () -> Void, updateViewOnce: @escaping (Bool) -> Void) {
+        self.update = update
+        self.openGhost = openGhost
+        self.openArchive = openArchive
+        self.updateViewOnce = updateViewOnce
+    }
+}
+
+private enum AyuSettingsEntry: ItemListNodeEntry {
+    case header(String)
+    case screen(Int32, String, Bool)
+    case option(Int32, AyuActivityPrivacySettings.Option, String, Bool)
+    case viewOnceHeader(String)
+    case viewOnce(Bool)
+    case footer(String)
+
+    var section: ItemListSectionId {
+        switch self {
+        case .viewOnceHeader, .viewOnce: return 1
+        case .footer: return 2
+        default: return 0
+        }
+    }
+
+    var stableId: Int32 {
+        switch self {
+        case .header: return 0
+        case let .screen(id, _, _): return id
+        case let .option(id, _, _, _): return id
+        case .viewOnceHeader: return 12
+        case .viewOnce: return 13
+        case .footer: return 100
+        }
+    }
+
+    static func < (lhs: AyuSettingsEntry, rhs: AyuSettingsEntry) -> Bool {
+        return lhs.stableId < rhs.stableId
+    }
+
+    func item(presentationData: ItemListPresentationData, arguments: Any) -> ListViewItem {
+        let arguments = arguments as! AyuSettingsArguments
+        switch self {
+        case let .header(text):
+            return ItemListSectionHeaderItem(presentationData: presentationData, text: text, sectionId: self.section)
+        case let .screen(_, title, ghost):
+            return ItemListDisclosureItem(presentationData: presentationData, systemStyle: .glass, title: title, label: "", sectionId: self.section, style: .blocks, action: {
+                if ghost { arguments.openGhost() } else { arguments.openArchive() }
+            })
+        case let .option(_, option, title, value):
+            return ItemListSwitchItem(presentationData: presentationData, systemStyle: .glass, title: title, value: value, maximumNumberOfLines: 0, sectionId: self.section, style: .blocks, updated: { value in
+                arguments.update(option, value)
+            })
+        case let .viewOnceHeader(text):
+            return ItemListSectionHeaderItem(presentationData: presentationData, text: text, sectionId: self.section)
+        case let .viewOnce(value):
+            let strings = presentationData.strings.localFeatures.ghostMode
+            return ItemListSwitchItem(presentationData: presentationData, title: strings.keepViewOnceMedia, text: strings.keepViewOnceMediaInfo, value: value, enabled: true, maximumNumberOfLines: 0, sectionId: self.section, style: .blocks, updated: { value in
+                arguments.updateViewOnce(value)
+            })
+        case let .footer(text):
+            return ItemListTextItem(presentationData: presentationData, text: .plain(text), sectionId: self.section)
+        }
+    }
+}
+
+public func ayuSettingsController(context: AccountContext) -> ViewController {
+    var pushController: ((ViewController) -> Void)?
+    let arguments = AyuSettingsArguments(update: { option, value in
+        let _ = context.engine.accountData.updateAyuActivityPrivacy(option: option, value: value).startStandalone()
+    }, openGhost: {
+        pushController?(ghostModeSettingsController(context: context))
+    }, openArchive: {
+        pushController?(localMessageArchiveSettingsController(context: context))
+    }, updateViewOnce: { value in
+        let _ = context.engine.messages.updateGhostModeSettings { current in
+            var updated = current
+            updated.keepViewOnceMedia = value
+            return updated
+        }.startStandalone()
+    })
+
+    let state = combineLatest(queue: .mainQueue(), context.sharedContext.presentationData, context.engine.accountData.ayuActivityPrivacySettings(), context.engine.messages.ghostModeSettings())
+    |> deliverOnMainQueue
+    |> map { presentationData, settings, ghostSettings -> (ItemListControllerState, (ItemListNodeState, Any)) in
+        let isRussian = presentationData.strings.primaryComponent.languageCode.hasPrefix("ru")
+        let entries: [AyuSettingsEntry] = [
+            .header(isRussian ? "ИНДИКАТОРЫ ДЕЙСТВИЙ" : "ACTIVITY INDICATORS"),
+            .screen(1, isRussian ? "Режим призрака" : "Ghost Mode", true),
+            .screen(2, isRussian ? "Сохранение сообщений" : "Saved messages", false),
+            .option(3, .typing, isRussian ? "Скрывать набор текста" : "Hide typing", settings.hideTyping),
+            .option(4, .recording, isRussian ? "Скрывать запись голосовых и кружков" : "Hide voice and video recording", settings.hideRecording),
+            .option(5, .uploads, isRussian ? "Скрывать индикаторы загрузки" : "Hide upload indicators", settings.hideUploads),
+            .option(6, .interactions, isRussian ? "Скрывать действия со стикерами, эмодзи и играми" : "Hide sticker, emoji and game activity", settings.hideInteractions),
+            .option(7, .sponsoredMessages, isRussian ? "Скрывать рекламные сообщения в чатах" : "Hide sponsored messages in chats", settings.hideSponsoredMessages),
+            .option(8, .readDate, isRussian ? "Сохранять примерную дату прочтения" : "Save approximate read date", settings.saveReadDate),
+            .option(9, .lastActivity, isRussian ? "Показывать примерную активность" : "Show approximate activity", settings.showLastActivityEstimate),
+            .option(10, .silentByDefault, isRussian ? "Отправлять без звука по умолчанию" : "Send without sound by default", settings.silentByDefault),
+            .option(11, .scheduleByDefault, isRussian ? "Отправлять с задержкой (12–30 сек.)" : "Delay outgoing messages (12–30 sec.)", settings.scheduleByDefault),
+            .viewOnceHeader(isRussian ? "ОДНОРАЗОВЫЕ МЕДИА" : "VIEW-ONCE MEDIA"),
+            .viewOnce(ghostSettings.keepViewOnceMedia),
+            .footer(isRussian
+                ? "Настройки действуют только для этого аккаунта в этом приложении. Скрытие индикаторов не отключает отправку файлов и сообщений. Режим призрака настраивается отдельно; активность с других устройств может быть видна."
+                : "These settings apply only to this account in this app. Hiding indicators does not stop messages or files from sending. Ghost Mode is configured separately; activity from other devices may remain visible.")
+        ]
+        let presentation = ItemListPresentationData(presentationData)
+        let controllerState = ItemListControllerState(presentationData: presentation, title: .text("Ayu Personal"), leftNavigationButton: nil, rightNavigationButton: nil, backNavigationButton: ItemListBackButton(title: presentationData.strings.Common_Back))
+        let listState = ItemListNodeState(presentationData: presentation, entries: entries, style: .blocks, animateChanges: false)
+        return (controllerState, (listState, arguments))
+    }
+    let controller = ItemListController(context: context, state: state)
+    pushController = { [weak controller] next in
+        (controller?.navigationController as? NavigationController)?.pushViewController(next)
+    }
+    return controller
+}
